---
interface Props { country: 'pk' | 'at' | 'ca' }
const { country } = Astro.props;
---
<svg class="country-flag" viewBox="0 0 30 20" width="18" height="12" aria-hidden="true">
  {country === 'pk' && <>
    <path fill="#fff" d="M0 0h30v20H0z"/><path fill="#145b37" d="M7 0h23v20H7z"/>
    <circle cx="19" cy="10" r="6" fill="#fff"/><circle cx="21" cy="8.5" r="5.3" fill="#145b37"/>
    <path fill="#fff" d="m22 4 .7 2.1H25l-1.8 1.3.7 2.1L22 8.2l-1.8 1.3.7-2.1-1.8-1.3h2.2Z"/>
  </>}
  {country === 'at' && <><path fill="#d83943" d="M0 0h30v20H0z"/><path fill="#fff" d="M0 6.67h30v6.66H0z"/></>}
  {country === 'ca' && <>
    <path fill="#fff" d="M0 0h30v20H0z"/><path fill="#df3542" d="M0 0h7v20H0zM23 0h7v20h-7z"/>
    <path fill="#df3542" d="m15 2.5 1.4 3.2 1.4-.8-.6 4 2.4-1.9.5 1.5 2-.3-1.6 3 1 1-5.8 1.2.4 2.1h-1.6l.4-2.1-5.8-1.2 1-1-1.6-3 2 .3.5-1.5L13.4 9l-.6-4 1.4.8Z"/>
  </>}
</svg>
<style>
  .country-flag{display:inline-block;width:18px;height:12px;margin-left:4px;vertical-align:-1px;border-radius:2px;box-shadow:0 0 0 1px #ffffff14}
</style>
