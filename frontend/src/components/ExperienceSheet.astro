<dialog class="experience-sheet" aria-label="Experience details">
  <iframe title="Experience details"></iframe>
</dialog>
<script>
  const sheet = document.querySelector<HTMLDialogElement>('.experience-sheet')!;
  const frame = sheet.querySelector<HTMLIFrameElement>('iframe')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const homeTitle = document.title;
  let origin: HTMLAnchorElement | null = null;
  let savedY = 0;
  let busy = false;
  let closing = false;
  let motion: Animation | undefined;
  let previousOverflow = '';
  let previousGutter = '';
  let previousRestoration: ScrollRestoration = 'auto';
  const duration = () => reduced.matches ? 0 : 850;

  function requestClose() {
    if (busy || !sheet.open) return;
    const goBack = Boolean(history.state?.experienceSheet);
    // Start moving on this click, without waiting for a history traversal.
    void closeSheet();
    if (goBack) history.back();
  }

  async function closeSheet() {
    if (!sheet.open || closing) return;
    closing = true;
    busy = true;
    motion?.cancel();
    sheet.dataset.closing = '';
    motion = sheet.animate([{ transform: 'translateY(0)' }, { transform: 'translateY(100%)' }], {
      duration: duration(), easing: 'cubic-bezier(.25,.6,.25,1)', fill: 'forwards',
    });
    await motion.finished.catch(() => {});
    sheet.close();
    motion.cancel();
    // Keep the document loaded; tearing it down here adds work to the final frame.
    document.documentElement.style.overflow = previousOverflow;
    document.documentElement.style.scrollbarGutter = previousGutter;
    window.scrollTo({ top: savedY, behavior: 'instant' });
    document.dispatchEvent(new CustomEvent('portfolio:experience-scroll', { detail: { open: false, y: savedY } }));
    origin?.focus({ preventScroll: true });
    document.title = homeTitle;
    history.scrollRestoration = previousRestoration;
    delete sheet.dataset.closing;
    closing = false;
    busy = false;
  }

  function openSheet(path: string, addHistory: boolean) {
    if (busy || sheet.open) return;
    busy = true;
    savedY = window.scrollY;
    previousOverflow = document.documentElement.style.overflow;
    previousGutter = document.documentElement.style.scrollbarGutter;
    previousRestoration = history.scrollRestoration;
    frame.onload = () => {
      const doc = frame.contentDocument;
      if (!doc) { busy = false; return; }
      frame.title = doc.title;
      document.title = doc.title;
      // Keep the existing page navigation, but return through the sheet animation.
      doc.addEventListener('click', event => {
        if (!(event.target as Element | null)?.closest) return;
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
        if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.target === '_blank') return;
        const url = new URL(link.href);
        if (url.origin === location.origin && url.pathname === '/') {
          event.preventDefault(); event.stopImmediatePropagation(); requestClose();
        }
      }, true);
      doc.addEventListener('keydown', event => {
        if (event.key === 'Escape' && !doc.querySelector('dialog[open]')) { event.preventDefault(); requestClose(); }
      });
      // Preserve the actual page layout and scroll offset underneath the sheet.
      document.dispatchEvent(new CustomEvent('portfolio:experience-scroll', { detail: { open: true, y: savedY } }));
      history.scrollRestoration = 'manual';
      document.documentElement.style.scrollbarGutter = 'stable';
      document.documentElement.style.overflow = 'hidden';
      if (addHistory) history.pushState({ ...history.state, experienceSheet: path }, '', path);
      sheet.showModal();
      motion = sheet.animate([{ transform: 'translateY(100%)' }, { transform: 'translateY(0)' }], {
        duration: duration(), easing: 'cubic-bezier(.22,1,.36,1)',
      });
      motion.finished.then(() => { if (!closing) { busy = false; frame.focus(); } }).catch(() => {});
    };
    frame.src = path;
  }

  document.querySelectorAll<HTMLAnchorElement>('.career-entry').forEach(link => {
    link.addEventListener('click', event => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (busy) return;
      origin = link;
      openSheet(link.pathname, true);
    });
  });
  sheet.addEventListener('cancel', event => { event.preventDefault(); requestClose(); });
  window.addEventListener('popstate', () => {
    if (history.state?.experienceSheet) openSheet(history.state.experienceSheet, false);
    else if (sheet.open) void closeSheet();
  });
</script>
<style>
  :global(html){scrollbar-gutter:stable}
  .experience-sheet{position:fixed;inset:0;width:100%;height:100dvh;max-width:none;max-height:none;margin:0;padding:0;border:0;background:#0c0e0c;overflow:hidden;color-scheme:dark;will-change:transform;backface-visibility:hidden}
  .experience-sheet::backdrop{background:#0003;transition:background .85s ease}
  .experience-sheet[data-closing]::backdrop{background:transparent}
  .experience-sheet iframe{display:block;width:100%;height:100%;border:0;background:#0c0e0c}
  @media(prefers-reduced-motion:reduce){.experience-sheet::backdrop{transition:none}}
</style>
