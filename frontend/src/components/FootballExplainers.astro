  .case-tabs{display:flex;gap:28px;border-bottom:1px solid var(--rule)}.case-tabs button{padding:13px 0;font-size:13px}.case-tabs button[aria-pressed=true]{box-shadow:inset 0 -2px var(--green)}.case-body{padding:27px 0 4px;min-height:270px}.essay-body .case-season{font:10px/1.5 'Courier New',monospace;color:#62715d}.essay-body .case-name{font-family:Georgia,serif;font-size:38px;line-height:1.2;font-weight:400;letter-spacing:-.04em;margin:10px 0 20px}.case-verdict{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.case-primary{font-size:18px;font-weight:500}.case-status{font:11px/1.5 'Courier New',monospace;color:#785a30;text-align:right}.essay-body .case-secondary{font-size:13px;color:#62715d;margin-top:8px}.case-evidence{display:grid;grid-template-columns:150px 1fr;gap:25px;margin-top:25px;padding-top:19px;border-top:1px solid var(--rule)}.case-evidence>span{font:9px/1.6 'Courier New',monospace;letter-spacing:.05em;max-width:125px}.essay-body .case-evidence p{font-size:13px}
  .weight-switch{display:flex;gap:28px;margin-bottom:20px;border-bottom:1px solid var(--rule)}.weight-switch button{font-size:12px;padding:12px 0}.weight-switch button[aria-pressed=true]{box-shadow:inset 0 -2px var(--green)}.weight-chart>div{display:grid;grid-template-columns:160px 1fr 35px;gap:20px;align-items:center;margin:22px 0}.weight-chart>div>span{font-size:13px}.weight-chart small{display:block;color:#73816c;font-size:10px}.weight-track{height:10px;background:#d5dbce}.weight-track i{display:block;height:100%;background:var(--green);transition:width .25s ease}.weight-chart b{font:12px 'Courier New',monospace}.essay-body .weight-explanation{font-size:12px;color:#62715d;min-height:42px}.revision-result{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:25px;border-top:1px solid var(--rule);margin-top:18px;padding-top:20px}.revision-result span{font-size:12px;color:#62715d}.revision-result span:last-child{text-align:right}.revision-result strong{font:38px Georgia,serif;white-space:nowrap}.revision-result s{color:#9b8c77;text-decoration-thickness:1px}
  .timing-row{display:grid;grid-template-columns:95px 1fr 95px;align-items:center;gap:20px;margin-top:25px;font-size:12px}.timing-row>div{height:17px;background:#d5dbce}.timing-row i{display:block;height:100%;background:var(--green);min-width:2px}.timing-row b{font:12px 'Courier New',monospace;text-align:right}.query-note{border-top:1px solid var(--rule);margin-top:28px;padding-top:20px;display:grid;grid-template-columns:1fr 1fr;gap:8px}.query-note>span{font-size:11px;color:#62715d}.query-note strong{font:15px 'Courier New',monospace;font-weight:400;text-align:right}.essay-body .query-note p{grid-column:1/-1;font-size:11px;color:#62715d}
  .essay .essay-body .analysis-sheet h3{color:var(--ink)}
  .football-source-note{padding-top:25px;border-top:1px solid #b8caa522;font-size:12px;color:#9da990}
  @media(min-width:1050px){.analysis-sheet{margin-left:-90px;margin-right:-90px}.football-figure{margin-left:-70px;margin-right:-70px}}
  @media(max-width:1049px){.recipe-layout{grid-template-columns:190px 1fr;gap:18px}.recipe-bars>div{grid-template-columns:1fr 55px 24px;gap:8px}.recipe-menu{padding-right:14px}}
  @media(max-width:650px){.analysis-sheet{padding:20px 18px;margin-block:35px}.sheet-heading{font-size:9px;gap:8px}.recipe-layout{grid-template-columns:1fr;gap:20px}.recipe-menu{display:grid;grid-template-columns:1fr 1fr;border-right:0;padding-right:0;gap:0 14px}.recipe-menu button{font-size:11px}.recipe-menu button>span{margin-right:5px}.recipe-bars>div{grid-template-columns:1fr 85px 24px}.case-tabs{gap:0;justify-content:space-between}.case-tabs button{font-size:12px}.case-body{min-height:340px}.essay-body .case-name{font-size:34px}.case-verdict{display:block}.case-status{display:block;text-align:left;margin-top:8px}.case-evidence{grid-template-columns:1fr;gap:9px}.case-evidence>span{max-width:none}.weight-chart>div{grid-template-columns:118px 1fr 30px;gap:12px}.weight-chart>div>span{font-size:12px}.revision-result{grid-template-columns:1fr auto;gap:12px}.revision-result span:last-child{grid-column:1/-1;text-align:left}.timing-row{grid-template-columns:72px 1fr 72px;gap:9px;font-size:10px}.timing-row b{font-size:10px}.query-note strong{font-size:12px}.query-note>span{font-size:10px}}
  @media(prefers-reduced-motion:reduce){.weight-track i{transition:none}}
</style>
