<script>
  const recipes: Record<string, {metrics: [string, number][], note: string}> = {
    playmaker: {metrics: [['Progressive passes',2],['Final-third entries',1.5],['Pass completion',1.5],['Passing under pressure',1]], note: 'Move it forward. Keep it. Do both when someone is closing you down.'},
    winner: {metrics: [['Ball recoveries',2],['Defensive duels',1.5],['Defensive actions',1.5],['Pressures',1]], note: 'Recoveries carry the most weight. Without them, this picture is incomplete.'},
    carrier: {metrics: [['Progressive carries',2],['Successful dribbles',1.5],['Threat added (xT)',1.5],['Ball recoveries',1]], note: 'Move the ball through midfield with your feet, then help win it back.'},
    attacker: {metrics: [['Penalty-area entries',2],['Expected goals',1.5],['Threat added (xT)',1.5],['Successful dribbles',1]], note: 'Arrive in dangerous areas and turn those arrivals into chances.'},
  };
  const recipeRoot = document.querySelector('.recipe-sheet');
  recipeRoot?.querySelectorAll<HTMLButtonElement>('[data-recipe]').forEach(button => button.addEventListener('click', () => {
    const recipe = recipes[button.dataset.recipe!];
    recipeRoot.querySelectorAll('[data-recipe]').forEach(item => item.setAttribute('aria-pressed',String(item === button)));
    const bars = recipeRoot.querySelector('.recipe-bars')!;
    bars.replaceChildren(...recipe.metrics.map(([label, weight]) => {
      const row = document.createElement('div');
      const name = document.createElement('span'); name.textContent = label;
      const bar = document.createElement('i'); bar.style.setProperty('--weight',`${weight / 2 * 100}%`);
      const number = document.createElement('b'); number.textContent = weight.toFixed(1);
      row.append(name,bar,number); return row;
    }));
    recipeRoot.querySelector('.recipe-note')!.textContent = recipe.note;
  }));
  const cases: Record<string, string[]> = {
    kante: ['2017/18 · Wyscout · midfielder', "N'Golo Kanté", 'Deep-lying playmaker', 'Limited by provider data', 'Secondary: ball-winning midfielder · 77', 'Pressures and recoveries are missing from this source. The winning label describes the available evidence, not every part of his game.'],
    kroos: ['2015/16 · StatsBomb · midfielder', 'Toni Kroos', 'Deep-lying playmaker', 'Recorded fit: 96', 'Profile peers included Busquets and Modrić.', 'The label matched his passing-led role. This is a useful sanity check, not proof that every player assessment is correct.'],
    pogba: ['2015/16 · StatsBomb · midfielder', 'Paul Pogba', 'Box-to-box carrier', 'Two playing styles retained', 'Secondary: attacking midfielder', 'The second profile preserves his attacking contribution instead of reducing the whole player to one job. The validation notes also describe blended team-style context.'],
    messi: ['2017/18 · Wyscout · forward', 'Lionel Messi', 'Creative attacker', 'Blended assessment', 'The two leading styles sit less than five points apart.', 'A narrow lead does not justify a definitive label. The assessment keeps that ambiguity visible. Wyscout coverage still limits which parts of his game can be measured.'],
  };
  const caseRoot = document.querySelector('.case-sheet');
  const caseSelectors = ['.case-season','.case-name','.case-primary','.case-status','.case-secondary','.case-evidence p'];
  caseRoot?.querySelectorAll<HTMLButtonElement>('[data-case]').forEach(button => button.addEventListener('click', () => {
    caseRoot.querySelectorAll('[data-case]').forEach(item => item.setAttribute('aria-pressed',String(item === button)));
    cases[button.dataset.case!].forEach((text, index) => { caseRoot.querySelector(caseSelectors[index])!.textContent = text; });
  }));
  const weightRoot = document.querySelector('.weight-sheet');
  weightRoot?.querySelectorAll<HTMLButtonElement>('[data-weight]').forEach(button => button.addEventListener('click', () => {
    const equal = button.dataset.weight === 'equal';
    weightRoot.querySelectorAll('[data-weight]').forEach(item => item.setAttribute('aria-pressed',String(item === button)));
    ['strong','average','weak'].forEach((key, index) => {
      const weight = equal ? 1 : index === 0 ? .85 : .25;
      (weightRoot.querySelector(`.weight-${key}`) as HTMLElement).style.width = `${weight * 100}%`;
      weightRoot.querySelector(`.weight-${key}-value`)!.textContent = weight.toFixed(2);
    });
    weightRoot.querySelector('.weight-explanation')!.textContent = equal ? 'Every area gets the same vote. Gains in a weak area can cancel out losses in the skills you wanted to keep.' : 'The strength gets 3.4 times the weight. Other areas still count.';
  }));
</script>
<style is:global>
