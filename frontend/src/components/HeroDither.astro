<hero-dither aria-hidden="true"><canvas></canvas></hero-dither>

<script>
  class HeroDither extends HTMLElement {
    private observer?: ResizeObserver;
    private visibility?: IntersectionObserver;
    private pixels?: ImageData;
    private frame = 0;
    private width = 0;
    private height = 0;
    private visible = false;
    private last = 0;
    private time = 0;
    private mouse = { x: .5, y: .5 };
    private target = { x: .5, y: .5 };
    private motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    private pointer = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse') return;
      const rect = this.getBoundingClientRect();
      this.target = { x: (event.clientX-rect.left)/rect.width, y: (event.clientY-rect.top)/rect.height };
    };
    private leave = () => { this.target = { x: .5, y: .5 }; };
    private sync = () => {
      cancelAnimationFrame(this.frame);
      this.last = 0;
      if (this.motion.matches) { this.time = 0; this.mouse = { x: .5, y: .5 }; this.draw(); }
      else if (this.visible && !document.hidden) this.frame = requestAnimationFrame(this.tick);
    };
    private tick = (now: number) => {
      const elapsed = this.last ? now-this.last : 42;
      if (elapsed >= 1000/24) {
        this.time += Math.min(elapsed, 80)/1000;
        this.last = now;
        this.mouse.x += (this.target.x-this.mouse.x)*.07;
        this.mouse.y += (this.target.y-this.mouse.y)*.07;
        this.draw();
      }
      this.frame = requestAnimationFrame(this.tick);
    };
    connectedCallback() {
      this.observer = new ResizeObserver(() => {
        const canvas = this.querySelector('canvas');
        const context = canvas?.getContext('2d');
        if (!canvas || !context) return;
        const rect = this.getBoundingClientRect();
        this.width = rect.width;
        this.height = rect.height;
        const cell = this.width < 600 ? 3 : 3.5;
        canvas.width = Math.ceil(this.width/cell);
        canvas.height = Math.ceil(this.height/cell);
        this.pixels = context.createImageData(canvas.width,canvas.height);
        this.draw();
      });
      this.observer.observe(this);
      this.visibility = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        this.sync();
      });
      this.visibility.observe(this);
      this.parentElement?.addEventListener('pointermove', this.pointer);
      this.parentElement?.addEventListener('pointerleave', this.leave);
      this.motion.addEventListener('change', this.sync);
      document.addEventListener('visibilitychange', this.sync);
    }
    disconnectedCallback() {
      this.observer?.disconnect();
      this.visibility?.disconnect();
      cancelAnimationFrame(this.frame);
      this.parentElement?.removeEventListener('pointermove', this.pointer);
      this.parentElement?.removeEventListener('pointerleave', this.leave);
      this.motion.removeEventListener('change', this.sync);
      document.removeEventListener('visibilitychange', this.sync);
    }
    private draw() {
      const context = this.querySelector('canvas')?.getContext('2d');
      const pixels = this.pixels;
      if (!context || !pixels) return;
      const {width,height,data} = pixels;
      const t = this.time*.23;
      // A continuous warped surface, quantized to two colours using an 8x8 Bayer matrix.
      // Adjacent lit pixels join into solid shapes; transition bands retain the grain.
      const bayer = [0,32,8,40,2,34,10,42,48,16,56,24,50,18,58,26,12,44,4,36,14,46,6,38,60,28,52,20,62,30,54,22,3,35,11,43,1,33,9,41,51,19,59,27,49,17,57,25,15,47,7,39,13,45,5,37,63,31,55,23,61,29,53,21];
      const smooth = (a: number,b: number,v: number) => {
        const n = Math.max(0,Math.min(1,(v-a)/(b-a)));
        return n*n*(3-2*n);
      };
      for(let y=0;y<height;y++) {
        const v=y/height;
        for(let x=0;x<width;x++) {
          const u=x/width;
          const px=u+(this.mouse.x-.5)*.035;
          const py=v+(this.mouse.y-.5)*.035;
          const wx=px+.19*Math.sin(py*5.5-t*.8)+.07*Math.cos(px*7+py*4+t*.5);
          const wy=py+.16*Math.sin(px*5+t*.6);
          const field=Math.sin(wx*9+wy*3-t)+.55*Math.cos(wy*9-wx*3+t*.7);
          const density=smooth(-.8,.9,field);
          const lit=density>(bayer[(y%8)*8+x%8]+.5)/64;
          const centre=1-.98*Math.exp(-Math.pow((u-.5)/.38,4)-Math.pow((v-.48)/.26,4));
          const edge=smooth(0,.12,u)*(1-smooth(.88,1,u))*smooth(0,.12,v)*(1-smooth(.82,1,v));
          const i=(y*width+x)*4;
          data[i]=83; data[i+1]=103; data[i+2]=62;
          data[i+3]=lit ? Math.round(112*centre*edge) : 0;
        }
      }
      context.putImageData(pixels,0,0);
    }
  }
  if (!customElements.get('hero-dither')) customElements.define('hero-dither', HeroDither);
</script>

<style>
  hero-dither{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden;contain:strict;mask-image:linear-gradient(transparent,#000 9%,#000 87%,transparent)}
  canvas{display:block;width:100%;height:100%;image-rendering:pixelated}
  @media(max-width:760px){hero-dither{opacity:.7}}
  @media(prefers-reduced-motion:reduce){canvas{animation:none}}
</style>