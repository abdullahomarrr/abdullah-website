---
// Render the starting surface into the HTML, before the canvas script loads.
const width = 320, height = 180;
const paths = Array.from({length:16}, () => '');
const bayer = [0,32,8,40,2,34,10,42,48,16,56,24,50,18,58,26,12,44,4,36,14,46,6,38,60,28,52,20,62,30,54,22,3,35,11,43,1,33,9,41,51,19,59,27,49,17,57,25,15,47,7,39,13,45,5,37,63,31,55,23,61,29,53,21];
const smooth = (a:number,b:number,v:number) => {
  const n = Math.max(0,Math.min(1,(v-a)/(b-a)));
  return n*n*(3-2*n);
};
for(let y=0;y<height;y++) for(let x=0;x<width;x++) {
  const u=x/width, v=y/height;
  const wx=u+.19*Math.sin(v*5.5)+.07*Math.cos(u*7+v*4);
  const wy=v+.16*Math.sin(u*5);
  const density=smooth(-.8,.9,Math.sin(wx*9+wy*3)+.55*Math.cos(wy*9-wx*3));
  if(density<=(bayer[(y%8)*8+x%8]+.5)/64) continue;
  const centre=1-.98*Math.exp(-Math.pow((u-.5)/.38,4)-Math.pow((v-.48)/.26,4));
  const edge=smooth(0,.12,u)*(1-smooth(.88,1,u))*smooth(0,.12,v)*(1-smooth(.82,1,v));
  const level=Math.round(15*centre*edge);
  if(level) paths[level]+=`M${x} ${y}h1v1h-1z`;
}
---
<hero-dither aria-hidden="true">
  <svg class="initial-surface" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" shape-rendering="crispEdges">
    {paths.map((d,i) => d && <path d={d} fill="#53673e" opacity={i/15*112/255}/>)}
  </svg>
  <canvas></canvas>
</hero-dither>

<script>
  import {palettes} from '../lib/atmosphere';
  class HeroDither extends HTMLElement {
    private observer?: ResizeObserver;
    private visibility?: IntersectionObserver;
    private pixels?: ImageData;
    private alpha = new Uint8Array(0);
    private context?: CanvasRenderingContext2D;
    private ready = false;
    private colour = [83,103,62];
    private targetColour = [83,103,62];
    private recolour = () => {
      const hex=palettes[document.documentElement.dataset.atmosphere || 'clear-night'] || palettes['clear-night'];
      this.targetColour=[1,3,5].map(i=>parseInt(hex.slice(i,i+2),16));
      if(!this.ready || this.motion.matches) this.colour=[...this.targetColour];
      if(this.pixels) this.draw();
    };
    private frame = 0;
    private width = 0;
    private height = 0;
    private visible = false;
    private last = 0;
    private time = 0;
    private mouse = { x: .5, y: .5 };
    private target = { x: .5, y: .5 };
    private pendingPointer?: {x:number; y:number};
    private motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    private pointer = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse') return;
      this.pendingPointer = {x:event.clientX,y:event.clientY};
    };
    private leave = () => { this.pendingPointer=undefined; this.target = { x: .5, y: .5 }; };
    private sync = () => {
      cancelAnimationFrame(this.frame);
      this.last = 0;
      if (this.motion.matches) { this.time = 0; this.mouse = { x: .5, y: .5 }; this.draw(); }
      else if (this.visible && !document.hidden) this.frame = requestAnimationFrame(this.tick);
    };
    private tick = (now: number) => {
      const interval = 1000/30;
      const elapsed = this.last ? now-this.last : interval;
      if (elapsed >= interval - .5) {
        this.time += Math.min(elapsed, 80)/1000;
        this.last = now;
        if(this.pendingPointer) {
          const rect=this.getBoundingClientRect();
          this.target={x:(this.pendingPointer.x-rect.left)/rect.width,y:(this.pendingPointer.y-rect.top)/rect.height};
          this.pendingPointer=undefined;
        }
        this.mouse.x += (this.target.x-this.mouse.x)*.07;
        this.mouse.y += (this.target.y-this.mouse.y)*.07;
        this.draw();
      }
      this.frame = requestAnimationFrame(this.tick);
    };
    connectedCallback() {
      this.recolour();
      document.addEventListener('portfolio:atmosphere',this.recolour);
      this.observer = new ResizeObserver(() => {
        const canvas = this.querySelector('canvas');
        const context = canvas?.getContext('2d');
        if (!canvas || !context) return;
        const rect = this.getBoundingClientRect();
        this.width = rect.width;
        this.height = rect.height;
        // Bound the work on large displays; CSS preserves the pixelated surface.
        const cell = Math.max(this.width < 600 ? 3 : 3.5, Math.sqrt(this.width*this.height/85000));
        const width = Math.ceil(this.width/cell), height = Math.ceil(this.height/cell);
        if(this.pixels?.width === width && this.pixels?.height === height) return;
        canvas.width = width;
        canvas.height = height;
        this.context = context;
        this.pixels = context.createImageData(canvas.width,canvas.height);
        this.alpha = new Uint8Array(width*height);
        const smooth = (a:number,b:number,v:number) => {
          const n=Math.max(0,Math.min(1,(v-a)/(b-a)));
          return n*n*(3-2*n);
        };
        // The vignette and colour are invariant: compute only on resize.
        for(let y=0;y<height;y++) for(let x=0;x<width;x++) {
          const u=x/width, v=y/height, i=y*width+x;
          const centre=1-.98*Math.exp(-Math.pow((u-.5)/.38,4)-Math.pow((v-.48)/.26,4));
          const edge=smooth(0,.12,u)*(1-smooth(.88,1,u))*smooth(0,.12,v)*(1-smooth(.82,1,v));
          this.alpha[i]=Math.round(112*centre*edge);
          this.pixels.data[i*4]=this.colour[0]; this.pixels.data[i*4+1]=this.colour[1]; this.pixels.data[i*4+2]=this.colour[2];
        }
        this.draw();
      });
      this.observer.observe(this);
      this.visibility = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        this.sync();
      });
      this.visibility.observe(this);
      this.parentElement?.addEventListener('pointermove', this.pointer);
      this.parentElement?.addEventListener('pointerleave', this.leave);
      this.motion.addEventListener('change', this.sync);
      document.addEventListener('visibilitychange', this.sync);
    }
    disconnectedCallback() {
      document.removeEventListener('portfolio:atmosphere',this.recolour);
      this.observer?.disconnect();
      this.visibility?.disconnect();
      cancelAnimationFrame(this.frame);
      this.parentElement?.removeEventListener('pointermove', this.pointer);
      this.parentElement?.removeEventListener('pointerleave', this.leave);
      this.motion.removeEventListener('change', this.sync);
      document.removeEventListener('visibilitychange', this.sync);
    }
    private draw() {
      const context = this.context;
      const pixels = this.pixels;
      if (!context || !pixels) return;
      const {width,height,data} = pixels;
      const changing=this.colour.some((channel,i)=>Math.abs(channel-this.targetColour[i])>.1);
      if(changing || this.motion.matches) {
        this.colour=this.colour.map((channel,i)=>channel+(this.targetColour[i]-channel)*.08);
        for(let i=0;i<data.length;i+=4) {
          data[i]=Math.round(this.colour[0]);data[i+1]=Math.round(this.colour[1]);data[i+2]=Math.round(this.colour[2]);
        }
      }
      const t = this.time*.23;
      // A continuous warped surface, quantized to two colours using an 8x8 Bayer matrix.
      // Adjacent lit pixels join into solid shapes; transition bands retain the grain.
      const bayer = [0,32,8,40,2,34,10,42,48,16,56,24,50,18,58,26,12,44,4,36,14,46,6,38,60,28,52,20,62,30,54,22,3,35,11,43,1,33,9,41,51,19,59,27,49,17,57,25,15,47,7,39,13,45,5,37,63,31,55,23,61,29,53,21];
      const smooth = (a: number,b: number,v: number) => {
        const n = Math.max(0,Math.min(1,(v-a)/(b-a)));
        return n*n*(3-2*n);
      };
      for(let y=0;y<height;y++) {
        const v=y/height;
        const py=v+(this.mouse.y-.5)*.035;
        const rowWarp=.19*Math.sin(py*5.5-t*.8);
        for(let x=0;x<width;x++) {
          const index=y*width+x;
          if(!this.alpha[index]) continue;
          const u=x/width;
          const px=u+(this.mouse.x-.5)*.035;
          const wx=px+rowWarp+.07*Math.cos(px*7+py*4+t*.5);
          const wy=py+.16*Math.sin(px*5+t*.6);
          const field=Math.sin(wx*9+wy*3-t)+.55*Math.cos(wy*9-wx*3+t*.7);
          const density=smooth(-.8,.9,field);
          const lit=density>(bayer[(y%8)*8+x%8]+.5)/64;
          data[index*4+3]=lit ? this.alpha[index] : 0;
        }
      }
      context.putImageData(pixels,0,0);
      if(!this.ready) { this.setAttribute('data-ready', ''); this.ready=true; }
    }
  }
  if (!customElements.get('hero-dither')) customElements.define('hero-dither', HeroDither);
</script>

<style>
  hero-dither{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden;contain:strict;mask-image:linear-gradient(transparent,#000 9%,#000 87%,transparent)}
  canvas,.initial-surface{position:absolute;inset:0;display:block;width:100%;height:100%;image-rendering:pixelated}
  hero-dither[data-ready] .initial-surface{display:none}
  .initial-surface path{fill:var(--tone-dither,#53673e)}
  @media(max-width:760px){hero-dither{opacity:.7}}
  @media(prefers-reduced-motion:reduce){canvas{animation:none}}
</style>
