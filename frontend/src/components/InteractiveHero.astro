---
import HeroDither from './HeroDither.astro';
import TravelAtlas from './TravelAtlas.astro';
import MovieRail from './MovieRail.astro';
import GameShelf from './GameShelf.astro';
import CatCarousel from './CatCarousel.astro';
import FootballPhotos from './FootballPhotos.astro';
---
<section class="intro-hero" aria-labelledby="intro-title">
  <HeroDither />
  <div class="intro-center">
    <p class="intro-kicker"> currently building at pyko · toronto</p>
    <h1 id="intro-title">
      <span class="intro-line"><span class="hello-phrase"><span class="arrival-word" style="--arrival:80ms;--settle:780ms">Hi,</span> <span class="arrival-word" style="--arrival:200ms;--settle:820ms">I’m</span> <span class="arrival-word" style="--arrival:350ms;--settle:950ms">Abdullah</span></span>
        <span class="portrait-anchor"><span class="portrait-hint" aria-hidden="true" hidden><span>press me</span><svg viewBox="0 0 120 52" fill="none"><path class="hint-curve" pathLength="1" d="M99 5C107 24 60 25 60 48"/><path class="hint-tip" pathLength="1" d="m52 40 8 9 8-10"/></svg></span><button class="portrait-trigger" data-reveal="social" aria-expanded="false" aria-controls="intro-social" aria-label="Abdullah’s social links"><img src="/abdullah.jpg" alt="" width="120" height="72"/></button></span>
      </span>
      <span class="intro-line"><span class="arrival-word" style="--arrival:650ms;--settle:700ms">a</span> <button class="word-trigger arrival-role" style="--arrival:650ms" data-reveal="software" aria-expanded="false" aria-controls="intro-software"><span class="arrival-word" style="--arrival:710ms;--settle:800ms">software</span> <span class="arrival-word" style="--arrival:840ms;--settle:850ms">engineer</span></button> <span class="arrival-word" style="--arrival:1020ms;--settle:700ms">&amp;</span> <button class="word-trigger arrival-role" style="--arrival:1060ms" data-reveal="curiosity" aria-expanded="false" aria-controls="intro-curiosity"><span class="arrival-word" style="--arrival:1120ms;--settle:800ms">project</span> <span class="arrival-word" style="--arrival:1250ms;--settle:850ms">builder</span><span class="trigger-star arrival-word" style="--arrival:1380ms;--settle:720ms" aria-hidden="true">✳</span></button><span class="arrival-word" style="--arrival:1450ms;--settle:650ms">.</span></span>
    </h1>
    <div class="intro-interests"><span>beyond the code</span><button data-reveal="football" aria-expanded="false" aria-controls="intro-football">football ↗</button><button data-reveal="places" aria-expanded="false" aria-controls="intro-places">travel ↗</button><button data-reveal="games" aria-expanded="false" aria-controls="intro-games">games ↗</button><button data-reveal="screen" aria-expanded="false" aria-controls="intro-screen">movies / tv ↗</button><button data-reveal="cats" aria-expanded="false" aria-controls="intro-cats">cats ↗</button></div>
    <div class="reveal-stage">
      <section class="intro-panel portrait-orbit" id="intro-social" aria-label="Social links" hidden>
        <a class="orbit-link" href="https://github.com/abdullahomarrr/" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4 1-4-2-6-2m12 5v-4c0-1-.3-1.7-1-2 3-.3 6-1.5 6-6a5 5 0 0 0-1.3-3.5c.1-1 .1-2.1-.3-3.2 0 0-1.1-.3-3.5 1.3a12 12 0 0 0-6 0C6.5 3 5.4 3.3 5.4 3.3 5 4.4 5 5.5 5.1 6.5A5 5 0 0 0 3.8 10c0 4.5 3 5.7 6 6-.7.3-1 1-1 2v4"/></svg><span>GitHub</span></a>
        <a class="orbit-link" href="https://www.linkedin.com/in/abdullahomarr/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><circle cx="5" cy="5" r="2"/><path d="M3.5 9h3v12h-3zM10 9h3v1.6c.8-1.2 1.8-1.9 3.6-1.9 3 0 4.4 1.8 4.4 5.1V21h-3v-6.5c0-1.8-.6-2.9-2.1-2.9-1.8 0-2.9 1.2-2.9 3.2V21h-3z"/></svg><span>LinkedIn</span></a>
        <a class="orbit-link" href="mailto:abdullahom07@gmail.com" aria-label="Email Abdullah"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg><span>Email</span></a>
        <a class="orbit-link" href="/Abdullah-Omar-Resume-SWE.pdf" target="_blank" rel="noopener noreferrer" aria-label="Resume (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg><span>Resume</span></a>
      </section>
      <section class="intro-panel word-detail role-detail" id="intro-software" aria-label="Software engineer" hidden>
        <p class="role-sentence"><span class="role-line">I’m a founding engineer at <a class="role-brand pyko-brand" href="/experience/pyko" aria-label="Pyko — my experience"><img src="/brands/pyko.svg" alt="Pyko" width="87" height="36" /><span aria-hidden="true">↗</span></a>.</span> <span class="role-line">I study Computer Science at <span class="university-brand">UofT <span class="university-crest" aria-hidden="true"><img src="/brands/uoft-crest.png" alt="" width="1280" height="1280" /></span></span>.</span></p>
      </section>
      <section class="intro-panel word-detail curiosity-detail" id="intro-curiosity" aria-label="Things I have built" hidden>
        <p class="built-intro">a few projects i’ve built.</p>
        <div class="built-projects">
          <a href="https://footballintelligencesystem.vercel.app" target="_blank" rel="noopener noreferrer"><span class="built-title">Football Intelligence <span aria-hidden="true">↗</span></span><span class="built-description">a platform for scouting football players.</span></a>
          <a href="https://strive-emberhacks.vercel.app" target="_blank" rel="noopener noreferrer"><span class="built-title">Strive <span aria-hidden="true">↗</span></span><span class="built-description">an ai notebook for working through maths.</span></a>
          <a href="https://guess-the-language-eight.vercel.app" target="_blank" rel="noopener noreferrer"><span class="built-title">DailyLingo <span aria-hidden="true">↗</span></span><span class="built-description">a daily game: hear a language, guess it.</span></a>
        </div>
      </section>
      <section class="intro-panel" id="intro-football" aria-label="Teams I support" hidden>
        <p class="panel-label">teams i support</p>
        <ul class="football-teams">
          <li><img class="team-crest" src="/teams/manchester-city.png" alt="Manchester City crest" width="42" height="42"/><div><span class="team-name">Manchester City</span><span class="team-detail">MANCHESTER, ENGLAND</span></div></li>
          <li><img class="team-crest" src="/teams/barcelona.png" alt="FC Barcelona crest" width="42" height="42"/><div><span class="team-name">FC Barcelona</span><span class="team-detail">BARCELONA, SPAIN</span></div></li>
        </ul>
          <FootballPhotos />
      </section>
      <section class="intro-panel leisure-panel game-popup" id="intro-games" aria-label="Games" hidden>
        <GameShelf />
      </section>
      <section class="intro-panel leisure-panel movie-popup" id="intro-screen" aria-label="Movies and TV shows" hidden>
        <p class="panel-label">a few favourites</p>
        <MovieRail />
      </section>
      <section class="intro-panel leisure-panel" id="intro-cats" aria-label="Cats" hidden>
        
        <CatCarousel />
      </section>
      <section class="intro-panel" id="intro-places" aria-label="Places I have travelled" hidden><TravelAtlas /></section>
    </div>
  </div>
  <div class="intro-bottom"></div>
</section>
<script>
const hero = document.querySelector<HTMLElement>('.intro-hero');
if (hero) {
 // Interaction always takes priority over the one-time entrance.
 const finishEntrance = () => {
   hero.getAnimations({subtree:true}).forEach(animation => {
     if(animation instanceof CSSAnimation && animation.animationName.startsWith('hero-arrival')) animation.finish();
   });
 };
 hero.addEventListener('pointerdown', finishEntrance, {once:true});
 hero.addEventListener('keydown', finishEntrance, {once:true});
 const portrait=hero.querySelector<HTMLButtonElement>('.portrait-trigger')!;
 const hint=hero.querySelector<HTMLElement>('.portrait-hint')!;
 const hintKey='portfolio:portrait-hint-dismissed';
 let hintSeen=false;
 try{hintSeen=localStorage.getItem(hintKey)==='true';}catch{}
 hint.hidden=hintSeen;
 portrait.addEventListener('click',()=>{
   try{localStorage.setItem(hintKey,'true');}catch{}
   if(hint.hidden)return;
   if(matchMedia('(prefers-reduced-motion: reduce)').matches){hint.hidden=true;return;}
   hint.animate([{opacity:1},{opacity:0}],{duration:220,fill:'forwards'}).onfinish=()=>{hint.hidden=true;};
 });
 const triggers = [...hero.querySelectorAll<HTMLButtonElement>('[data-reveal]')];
 const panels = [...hero.querySelectorAll<HTMLElement>('.intro-panel')];
 const stage = hero.querySelector<HTMLElement>('.reveal-stage')!;
 const center = hero.querySelector<HTMLElement>('.intro-center')!;
 let active: HTMLButtonElement | null = null;
 
 
 
 function close(restore = false) {
  
  const previous = active;
  triggers.forEach(button => button.setAttribute('aria-expanded', 'false'));
    panels.forEach(panel => {
   if(panel.id === 'intro-social' && !panel.hidden && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const links = [...panel.querySelectorAll<HTMLElement>('.orbit-link')];
    links.forEach((link,i) => {
     link.getAnimations().forEach(animation => animation.cancel());
     const motion = link.animate([{opacity:1,transform:'none'},{opacity:0,transform:`translate(${(1.5-i)*5}px, 10px) scale(.94)`}],{duration:200,delay:(3-i)*15,easing:'cubic-bezier(.4,0,.6,1)',fill:'forwards'});
     if(i===0) motion.onfinish=()=>{ if(active?.dataset.reveal!=='social') panel.hidden=true; };
    });
   } else if (!panel.hidden && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const opacity = getComputedStyle(panel).opacity;
    panel.getAnimations().forEach(animation => animation.cancel());
    panel.style.pointerEvents = 'none';
    const fade = panel.animate([{opacity},{opacity:0}], {duration:160,easing:'ease-out',fill:'forwards'});
    fade.onfinish = () => {
     if(active?.getAttribute('aria-controls') !== panel.id) panel.hidden = true;
     fade.cancel();
     panel.style.pointerEvents = '';
    };
   } else panel.hidden = true;
  });
  active = null;
  hero!.classList.remove('has-reveal', 'has-annotation', 'has-social');
  if (restore) previous?.focus();
 }
  function positionPanel(button: HTMLButtonElement) {
  const anchor = button.getBoundingClientRect();
  const bounds = center.getBoundingClientRect();
    if(button.dataset.reveal === 'social') {
   const orbitWidth = Math.min(180, bounds.width);
   stage.style.width = `${orbitWidth}px`;
   stage.style.left = `${Math.max(0, Math.min(bounds.width-orbitWidth, anchor.left-bounds.left+anchor.width/2-orbitWidth/2))}px`;
   stage.style.top = `${anchor.top-bounds.top-66}px`;
   return;
  }
  const annotation = ['software', 'curiosity'].includes(button.dataset.reveal || '');
  const football = button.dataset.reveal === 'football';
  const travel = button.dataset.reveal === 'places';
  const leisure = ['games', 'screen', 'cats'].includes(button.dataset.reveal || '');
  const panelWidth = Math.min(annotation ? anchor.width : button.dataset.reveal === 'cats' ? 320 : button.dataset.reveal === 'screen' ? 510 : button.dataset.reveal === 'games' ? 300 : football || travel || leisure ? 280 : 360, bounds.width);
  const preferredLeft = anchor.left - bounds.left + (football || travel || leisure ? (anchor.width - panelWidth) / 2 : 0);
  const left = Math.max(0, Math.min(preferredLeft, bounds.width - panelWidth));
  stage.style.setProperty("--stem-x", `${Math.max(16, Math.min(panelWidth - 16, anchor.left - bounds.left - left + anchor.width / 2))}px`);
  stage.style.width = `${panelWidth}px`;
  stage.style.left = `${left}px`;
  const bottom = anchor.bottom;
  if (football) {
   const panel = document.getElementById('intro-football')!;
   const viewport = window.visualViewport;
   const viewportTop = (viewport?.offsetTop ?? 0) + 12;
   const viewportBottom = (viewport?.offsetTop ?? 0) + (viewport?.height ?? window.innerHeight) - 12;
   panel.style.maxHeight = '';
   panel.style.overflowY = '';
   const height = panel.offsetHeight;
   const below = Math.max(0, viewportBottom - anchor.bottom - 8);
   const openAbove = height > below;
   const available = openAbove ? viewportBottom - viewportTop : below;
   panel.style.boxSizing = 'border-box';
   panel.style.maxHeight = `${available}px`;
   panel.style.overflowY = height > available ? 'auto' : 'visible';
   stage.style.top = `${(openAbove ? Math.max(viewportTop, anchor.top - panel.offsetHeight - 8) : anchor.bottom + 8) - bounds.top}px`;
   return;
  }
  stage.style.top = travel || ['screen', 'cats'].includes(button.dataset.reveal || '')
    ? `${Math.max(8, anchor.top - stage.offsetHeight - 8) - bounds.top}px`
    : `${bottom - bounds.top + 8}px`;
 }
 window.addEventListener('resize', () => { if(active) positionPanel(active); });
 window.addEventListener('scroll', () => { if(active?.dataset.reveal === 'football') positionPanel(active); }, {passive:true});
 window.visualViewport?.addEventListener('resize', () => { if(active?.dataset.reveal === 'football') positionPanel(active); });
 function open(button: HTMLButtonElement) {
  
  const enteringSocial = button.dataset.reveal === "social" && active !== button;
  triggers.forEach(trigger => trigger.setAttribute('aria-expanded', String(trigger === button)));
  panels.forEach(panel => {
   panel.getAnimations().forEach(animation => animation.cancel());
   panel.style.pointerEvents = '';
   panel.hidden = panel.id !== button.getAttribute('aria-controls');
  });
    active = button; positionPanel(button);
  if(button.dataset.reveal !== 'social' && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
   const panel = document.getElementById(button.getAttribute('aria-controls')!)!;
   panel.animate([{opacity:0},{opacity:1}], {duration:260,easing:'cubic-bezier(.22,1,.36,1)'});
  }
  if(enteringSocial) {
   hero!.querySelectorAll<HTMLElement>('.orbit-link').forEach((link,i)=>{
    link.getAnimations().forEach(animation=>animation.cancel());
    if(!matchMedia('(prefers-reduced-motion: reduce)').matches) link.animate([
     {opacity:0,transform:`translate(${(1.5-i)*5}px, 10px) scale(.94)`},
     {opacity:1,transform:'none'}
    ],{duration:340,delay:i*25,easing:'cubic-bezier(.22,1,.36,1)',fill:'both'});
   });
  }
  hero!.classList.add('has-reveal');
  hero!.classList.toggle('has-social', button.dataset.reveal === 'social');
  hero!.classList.toggle('has-annotation', ['software', 'curiosity'].includes(button.dataset.reveal || ''));
 }
 triggers.forEach(button => {
   let hoverFrame = 0, hoverX = 0, hoverY = 0;
   button.addEventListener('pointermove', event => {
     if(event.pointerType !== 'mouse') return;
     hoverX=event.clientX; hoverY=event.clientY;
     if(hoverFrame) return;
     hoverFrame=requestAnimationFrame(() => {
       hoverFrame=0;
       const bounds = button.getBoundingClientRect();
       button.style.setProperty('--hover-x', `${hoverX-bounds.left}px`);
       button.style.setProperty('--hover-y', `${hoverY-bounds.top}px`);
     });
   });
   button.addEventListener('click', () => {
     if(active === button) close(); else open(button);
   });
 });
panels.forEach(panel => {
  
  
  panel.querySelector('.panel-close')?.addEventListener('click', () => close(true));
  panel.querySelectorAll('a').forEach(link => link.addEventListener('click', () => close()));
 });
 document.addEventListener('pointerdown', event => { if(active && event.target instanceof Element && !event.target.closest('[data-reveal], .intro-panel')) close(); });
 hero.addEventListener('keydown', event => { if(event.key === 'Escape' && active) {event.preventDefault(); close(true);} });
 hero.addEventListener('focusout', () => { setTimeout(() => {if(active && !document.querySelector(".football-gallery[open]") && !hero.contains(document.activeElement)) close();},0); });
}
</script>
<style>

.intro-hero{position:relative;min-height:calc(100svh - var(--nav-height));display:flex;flex-direction:column;justify-content:center;border-bottom:1px solid var(--line);padding:64px 0 128px;isolation:isolate}
.intro-grain{position:absolute;inset:10% 0;z-index:-1;pointer-events:none;background:radial-gradient(#c5ed9c35 .7px,transparent .8px);background-size:8px 8px;mask-image:radial-gradient(ellipse at 50% 50%,transparent 45%,#0007 100%);opacity:.24}
.intro-center{text-align:center;position:relative;width:100%;max-width:1060px;margin:0 auto}
.intro-kicker{font:300 12px/1.4 'Hero Light',Satoshi,Arial,sans-serif;letter-spacing:.02em;color:#8f9a87;margin-bottom:14px;display:flex;align-items:center;justify-content:center;gap:9px}.intro-kicker>span{width:5px;height:5px;border-radius:50%;background:var(--lime)}
h1{font-size:clamp(28px,3.7vw,50px);font-weight:500;line-height:1.4;letter-spacing:-.045em}.intro-line{display:flex;justify-content:center;align-items:center;flex-wrap:nowrap;gap:.18em}
.word-trigger{font:inherit;letter-spacing:inherit;line-height:1.17;color:inherit;background:#20251e;border:1px solid transparent;padding:6px 14px 9px;border-radius:14px;cursor:pointer;transition:background .22s,border-color .22s,color .22s}.word-trigger[aria-expanded=true],.word-trigger:hover{background:#293722;border-color:#98ba76;color:#d8f4bf}.trigger-star{display:inline-block;color:var(--lime);font-size:.6em;margin-left:14px;vertical-align:middle}.portrait-trigger{position:relative;width:82px;height:51px;padding:0;border:1px solid #667459;border-radius:60px;overflow:hidden;cursor:pointer;transform:rotate(-7deg);margin-left:10px;transition:transform .25s,border-color .25s}.portrait-trigger img{width:100%;height:100%;object-fit:cover;object-position:48% 36%;transform:scale(1.6)}.portrait-trigger>span{position:absolute;right:8px;bottom:2px;font-size:18px;color:white}.portrait-trigger[aria-expanded=true]{transform:rotate(0);border-color:var(--lime)}
.intro-interests{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:10px;margin-top:32px;color:#a5ac9f;font-size:14px}.intro-interests button{color:#d3dbca;background:#1b2019;border:1px solid #2c3428;border-radius:7px;padding:7px 12px;cursor:pointer;transition:background .2s}.intro-interests button[aria-expanded=true]{background:#2c3b23;border-color:#9dbd7d}.intro-aside{font-size:12px;color:#7e8976;margin-left:4px}
.reveal-stage{position:absolute;top:calc(100% + 20px);width:min(680px,100%);left:50%;transform:translateX(-50%);z-index:5;text-align:left}.intro-panel{padding:32px;border:1px solid #414d36;background:#191f16;border-radius:19px;box-shadow:0 25px 65px #0009;position:relative;animation:reveal .22s ease-out}.intro-panel[hidden]{display:none}.panel-close{position:absolute;top:12px;right:14px;border:0;background:transparent;color:#a5b698;font-size:23px;cursor:pointer;width:30px;height:30px}.panel-label{font:9px var(--font-detail);letter-spacing:.08em;color:#a4b795;margin-bottom:23px;padding-right:22px;line-height:1.6}.panel-story{font-size:26px;line-height:1.6;letter-spacing:-.025em;color:#e7ecdf}.panel-story a{color:#d3eebb;text-decoration:underline;text-decoration-color:#6d8555;text-underline-offset:5px}.panel-highlight{color:#b5c8a3}.inline-project{display:inline;white-space:nowrap}.inline-project img{display:inline-block;width:50px;height:32px;object-fit:cover;border-radius:5px;vertical-align:middle;margin-right:6px;transform:rotate(-5deg)}.panel-link{display:inline-block;font-size:12px;padding:11px 17px;border:1px solid #647255;border-radius:30px;margin-top:25px}.panel-link:hover{background:#2b3822}.social-links{display:flex;gap:12px;flex-wrap:wrap}.social-links a{padding:12px 20px;border:1px solid #526147;border-radius:30px;font-size:15px}.social-links a:hover{background:#2b3822}.small-story{font-size:20px}.club-row,.place-route{display:flex;gap:14px;align-items:center;justify-content:space-between;margin:0 0 22px;font-size:23px;letter-spacing:-.04em}.club-row>span{background:#242d20;padding:15px;font-size:17px;flex:1;display:flex;justify-content:space-between}.club-row i,.place-route i{font-style:normal;color:#8eae72}.intro-bottom{position:absolute;bottom:28px;left:0;right:0;display:flex;align-items:center;justify-content:center;gap:15px}.intro-bottom>span{font:8px var(--font-detail);letter-spacing:.08em;color:#829074}.intro-bottom>a{display:flex;align-items:center;gap:12px;border:1px solid #3c4635;border-radius:50px;background:#191f16;padding:8px 18px 8px 8px;font-size:12px}.mini-work{background:#c5ed9c;color:#182012;padding:7px 12px;border-radius:50%;font-size:17px}.intro-bottom>a:hover{border-color:var(--lime)}
@keyframes reveal{from{opacity:0;transform:translateY(8px) scale(.985)}to{opacity:1;transform:none}}

@media(max-width:760px){.intro-hero{min-height:calc(100svh - var(--nav-height));padding: max(64px, calc((100svh - var(--nav-height) - 330px) / 2 - 29px)) 0 105px;justify-content:flex-start}.intro-kicker{font-size:11px;letter-spacing:.02em;margin-bottom:12px}h1{font-size:clamp(29px,6.6vw,49px);line-height:1.55}.intro-line{flex-wrap:wrap}h1 .intro-line:first-child{font-size:1em;margin-bottom:6px}.word-trigger{white-space:nowrap}.word-trigger{padding:4px 5px 6px;border-radius:7px}.portrait-trigger{width:65px;height:43px;margin-left:3px}.intro-interests{font-size:12px;margin-top:25px;gap:8px}.intro-aside{width:100%;margin:7px 0 0}.intro-bottom>span{display:none}.intro-bottom{justify-content:center}.reveal-stage{position:relative;top:auto;left:auto;transform:none;margin-top:20px}.intro-panel{padding:24px 20px}.panel-story{font-size:21px}.panel-label{font-size:8px}.place-route{font-size:19px;gap:8px}.small-story{font-size:17px}.trigger-star{display:none}.social-links a{padding:10px 12px;font-size:13px}}
@media(prefers-reduced-motion:reduce){.intro-panel{animation:none}.word-trigger,.portrait-trigger,.intro-interests button{transition:none}}
/* Compact popovers are positioned against their own trigger, not the interests row. */
.reveal-stage{position:absolute;transform:none;margin:0;z-index:10}
.intro-panel{padding:20px;border-radius:12px;box-shadow:0 14px 35px #0008}
.panel-label{font-size:8px;margin-bottom:12px;letter-spacing:.04em;padding-right:18px}
.panel-story,.small-story{font-size:16px;line-height:1.6;letter-spacing:-.015em}
.panel-close{top:6px;right:7px;font-size:19px;width:28px;height:28px}
.panel-link{font-size:11px;padding:8px 12px;margin-top:16px}
.inline-project img{width:34px;height:23px}
.social-links{gap:8px}.social-links a{font-size:12px;padding:8px 11px}
.club-row,.place-route{font-size:16px;gap:10px;margin-bottom:14px}
