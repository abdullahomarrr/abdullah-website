---
interface Props {
 photos: {src:string; alt:string; position?:string}[];
 label: string;
 kind: 'football' | 'cat';
}
const {photos, label, kind} = Astro.props;
---
<div class:list={["football-photos", {"cat-photos": kind === "cat"}]} data-photo-carousel>
  <div class="strip-heading"><span>{label}</span><div><button type="button" data-step="-1" aria-label={`Previous ${kind} photos`}>←</button><button type="button" data-step="1" aria-label={`Next ${kind} photos`}>→</button></div></div>
  <div class="football-strip" aria-label={`${kind} photos`}>
    {photos.map((photo, i) => <button type="button" data-football-photo={i} aria-label={`Enlarge ${kind} photo ${i + 1}`}><img src={photo.src} alt={photo.alt} style={{objectPosition: photo.position}} width="160" height="100" loading="lazy" decoding="async" /></button>)}
  </div>
<dialog class="football-gallery" aria-label={`${kind} photo gallery`}>
  <header><span>{label}</span><button type="button" class="gallery-close" aria-label={`Close ${kind} gallery`}>close ×</button></header>
  <div class="football-stage"><button type="button" data-gallery-step="-1" aria-label="Previous photo">←</button><div class="football-image"><img src={photos[0].src} alt={photos[0].alt} /></div><button type="button" data-gallery-step="1" aria-label="Next photo">→</button></div>
  <div class="football-thumbs" aria-label={`Choose a ${kind} photo`}>{photos.map((photo, i) => <button type="button" data-football-thumb={i} aria-label={`Show ${kind} photo ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}><img src={photo.src} alt={photo.alt} width="88" height="58" /></button>)}</div>
</dialog>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-photo-carousel]').forEach(root => {
  const strip = root.querySelector<HTMLElement>('.football-strip')!;
  const gallery = root.querySelector<HTMLDialogElement>('.football-gallery')!;
  const frame = gallery.querySelector<HTMLElement>('.football-image')!;
  const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-football-thumb]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let selected = 0, busy = false, oldOverflow = '';
  let opener: HTMLButtonElement | null = null;
  document.body.append(gallery);
  const timing = () => ({ duration: reduced.matches ? 0 : 460, easing: 'cubic-bezier(.22,1,.36,1)' });
  async function select(index: number, animate = true) {
    if (busy) return;
    busy = true;
    selected = (index + thumbs.length) % thumbs.length;
    const source = thumbs[selected].querySelector('img')!;
    const next = new Image(); next.src = source.src; next.alt = source.alt;
    try { await next.decode(); } catch {}
    const previous = frame.querySelector('img')!;
    frame.append(next);
    thumbs.forEach((thumb, i) => thumb.setAttribute('aria-pressed', String(i === selected)));
    if (animate && !reduced.matches) {
      await Promise.all([
        previous.animate([{opacity:1},{opacity:0}], timing()).finished,
        next.animate([{opacity:0,transform:'translateY(8px)'},{opacity:1,transform:'translateY(0)'}], timing()).finished,
      ]);
    }
    previous.remove(); busy = false;
  }
  let pauseUntil = 0;
  const pause = () => { pauseUntil = Date.now() + 6500; };
  function advance(direction: number) {
    const max = strip.scrollWidth - strip.clientWidth;
    const step = strip.querySelector('button')!.getBoundingClientRect().width + 8;
    const end = direction > 0 ? strip.scrollLeft >= max - 2 : strip.scrollLeft <= 2;
    strip.scrollTo({left: end ? (direction > 0 ? 0 : max) : strip.scrollLeft + direction * step, behavior: reduced.matches ? 'instant' : 'smooth'});
  }
  root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button => button.addEventListener('click', () => {pause(); advance(Number(button.dataset.step));}));
  root.addEventListener('pointerdown', pause);
  root.addEventListener('wheel', pause, {passive:true});
  setInterval(() => {
    if(reduced.matches || document.hidden || gallery.open || root.closest('[hidden]') || root.matches(':hover, :focus-within') || Date.now() < pauseUntil) return;
    const bounds = root.getBoundingClientRect();
    if(bounds.bottom > 0 && bounds.top < innerHeight) advance(1);
  }, 3800);
  strip.querySelectorAll<HTMLButtonElement>('[data-football-photo]').forEach(button => button.addEventListener('click', async () => {
    if (busy) return;
    opener = button;
    await select(Number(button.dataset.footballPhoto), false);
    oldOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
    gallery.showModal();
    gallery.animate([{opacity:0},{opacity:1}], timing());
    frame.animate([{transform:'scale(.96)'},{transform:'scale(1)'}], timing());
  }));
  async function close() {
    if (busy || !gallery.open) return;
    busy = true;
    await gallery.animate([{opacity:1},{opacity:0}], timing()).finished;
    gallery.close(); document.documentElement.style.overflow = oldOverflow;
    opener?.focus({preventScroll:true}); busy = false;
  }
  thumbs.forEach((button,i) => button.addEventListener('click', () => { if(i !== selected) select(i); }));
  gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-step]').forEach(button => button.addEventListener('click', () => select(selected + Number(button.dataset.galleryStep))));
  gallery.querySelector('.gallery-close')!.addEventListener('click', close);
  gallery.addEventListener('cancel', event => { event.preventDefault(); close(); });
  gallery.addEventListener('pointerdown', event => event.stopPropagation());
  gallery.addEventListener('click', event => { if(event.target === gallery || event.target === frame) close(); });
  gallery.addEventListener('keydown', event => {
    event.stopPropagation();
    if(event.key === 'ArrowRight' || event.key === 'ArrowLeft') {event.preventDefault(); select(selected + (event.key === 'ArrowRight' ? 1 : -1));}
  });
  });
</script>
<style>
  .football-photos{margin-top:18px;padding-top:12px;border-top:1px solid #ffffff12}
  .strip-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;color:#9ba891;font-size:10px}
  .strip-heading>div{display:flex;gap:4px}
  .strip-heading button{border:0;background:none;color:#bac8ad;width:24px;height:24px;padding:0;cursor:pointer}
  .football-strip{display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;border-radius:7px}
  .football-strip::-webkit-scrollbar{display:none}
  .football-strip button{flex:0 0 136px;scroll-snap-align:start;padding:0;border:0;border-radius:7px;overflow:hidden;cursor:pointer;background:#111}
  .football-strip img{display:block;width:136px;height:82px;object-fit:cover;transition:filter .3s}
  .football-strip button:hover img{filter:brightness(1.12)}
  .football-gallery{position:fixed;inset:0;width:100%;height:100dvh;max-width:none;max-height:none;margin:0;padding:24px 32px;border:0;background:#0c0e0cf5;color:#eef0e8;backdrop-filter:blur(22px);box-sizing:border-box}
  .football-gallery[open]{display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:24px}
  .football-gallery::backdrop{background:transparent}
  .football-gallery header{display:flex;align-items:center;justify-content:space-between;font-size:13px;color:#a4af99}
  .football-gallery button{font:inherit;color:inherit;cursor:pointer}
  .gallery-close,.football-stage>button{border:0;background:transparent;padding:12px}
  .football-stage{display:grid;grid-template-columns:40px minmax(0,1fr) 40px;gap:20px;min-height:0;align-items:center}
  .football-image{position:relative;height:100%;min-height:0}
  .football-image :global(img){position:absolute;inset:0;width:100%;height:100%;object-fit:contain;border-radius:8px}
  .football-thumbs{display:flex;justify-content:safe center;gap:10px;overflow-x:auto;scrollbar-width:thin}.football-thumbs button{flex-shrink:0}
  .football-thumbs button{padding:3px;border:1px solid transparent;border-radius:7px;background:none;opacity:.45;transition:opacity .3s,border-color .3s}
  .football-thumbs button[aria-pressed=true]{opacity:1;border-color:#c5ed9c}
  .football-thumbs button:hover{opacity:1}
  .football-thumbs img{display:block;width:88px;height:58px;object-fit:cover;border-radius:4px}
  .cat-photos{margin:0;padding:0;border:0}
  .cat-photos .football-strip button{flex-basis:94px}
  .cat-photos .football-strip img{width:94px;height:112px}
  button:focus-visible{outline:2px solid #c5ed9c;outline-offset:2px}
  @media(max-width:600px){.football-gallery{padding:16px 12px;gap:16px}.football-stage{grid-template-columns:24px minmax(0,1fr) 24px;gap:4px}.football-stage>button{padding:0}.football-thumbs{gap:6px}.football-thumbs img{width:64px;height:46px}}
  @media(prefers-reduced-motion:reduce){.football-strip img,.football-thumbs button{transition:none}}
</style>
