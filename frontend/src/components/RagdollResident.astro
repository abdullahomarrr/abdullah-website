---
---
<div class="ragdoll-resident" data-state="sitting" data-facing="left">
  <button class="ragdoll-pet" type="button" aria-label="Pet the ragdoll kitten" title="a little company">
    <span class="kitten-heart" aria-hidden="true">♡</span>
    <svg class="kitten" viewBox="0 0 160 120" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="ragdoll-coat" x1="60" y1="40" x2="84" y2="106" gradientUnits="userSpaceOnUse"><stop stop-color="#fff8e9"/><stop offset=".5" stop-color="#e8dfcf"/><stop offset="1" stop-color="#bfb6a8"/></linearGradient>
        <linearGradient id="ragdoll-point" x1="0" y1="0" x2="52" y2="48" gradientUnits="userSpaceOnUse"><stop stop-color="#978c83"/><stop offset=".5" stop-color="#6a6562"/><stop offset="1" stop-color="#474849"/></linearGradient>
        <linearGradient id="ragdoll-tail" x1="24" y1="56" x2="66" y2="92" gradientUnits="userSpaceOnUse"><stop stop-color="#625f5c"/><stop offset=".55" stop-color="#918a81"/><stop offset="1" stop-color="#b3a99a"/></linearGradient>
        <radialGradient id="ragdoll-eye"><stop stop-color="#b9ecff"/><stop offset=".6" stop-color="#79bce0"/><stop offset="1" stop-color="#3c7a9e"/></radialGradient>
        <g id="ragdoll-face">
          <path d="M8 23 5 4Q5 0 9 3l13 11q9-3 17 0L51 3q4-3 4 2l-3 19 3 9-4-1 2 6-5-1 1 5-5-1q-14 15-27 0l-6 2 1-5-6 1 2-6-4 1Z" fill="url(#ragdoll-point)" stroke="#a49b8c" stroke-width=".7" stroke-linejoin="round"/>
          <path d="m9 6 10 11-9 3Zm41 0-9 11 9 3Z" fill="#c6a79c"/><path d="m10 8 2 9 5-1m30-8-2 9-3-1" stroke="#e3c5b4" stroke-width=".8"/>
          <path d="M28 13q2 9-1 16-1 5-6 8-7 3-9 1 4 13 18 14 14-2 18-14-4 3-10-1-8-5-9-12Z" fill="#f9f0df"/>
          <path d="m13 36-5 4 8-1-3 5 7-1-2 5 6-2m19-10 7 3-6 1 4 4-7-1 2 5-7-2" fill="#eee4d2"/>
          <path d="M10 27q5-6 13-1-4 8-12 4Z" fill="#292e30"/><path d="M35 26q8-5 14 1l-2 4q-8 3-12-5Z" fill="#292e30"/>
          <g class="kitten-eye"><ellipse cx="17" cy="28" rx="4" ry="3.6" fill="url(#ragdoll-eye)"/><ellipse cx="41" cy="28" rx="4" ry="3.6" fill="url(#ragdoll-eye)"/><ellipse cx="17.5" cy="28" rx="1.4" ry="3" fill="#233847"/><ellipse cx="40.5" cy="28" rx="1.4" ry="3" fill="#233847"/><circle cx="16" cy="26.5" r="1.1" fill="#fff"/><circle cx="39.5" cy="26.5" r="1.1" fill="#fff"/></g>
          <path d="M10 25q6-4 13 0m12 0q8-4 14 1" stroke="#4a4947" stroke-width="1.2" stroke-linecap="round"/>
          <path d="m25 37 4 3 4-3q-4-3-8 0Z" fill="#ba908c" stroke="#926d6a" stroke-width=".6"/><path d="M29 40v3m0 0q-3 3-6 0m6 0q3 3 6 0" stroke="#8a8076" stroke-width=".8" stroke-linecap="round"/>
          <g stroke="#ded8ca" stroke-width=".65" stroke-linecap="round" opacity=".85"><path d="m18 37-17-3m16 6L0 41m19 2L3 47m36-10 18-3m-17 6 17 1m-18 2 16 4"/></g>
          <g stroke="#cfc4b4" stroke-width=".6" stroke-linecap="round" opacity=".7"><path d="m23 15 1 5m9-5-1 5m-14 25 3 3m18-3-3 3M25 47l2 2m7-2-2 2"/></g>
        </g>
      </defs>
      <ellipse class="kitten-shadow" cx="80" cy="110" rx="48" ry="4" fill="#000" opacity=".22"/>
      <g class="kitten-facing">
        <g class="pose-walk">
          <path class="tail" d="M47 70C20 73 9 51 16 34q5-11 11-5l-1 8 3-2-2 8 3-1q-2 14 21 14Z" fill="url(#ragdoll-tail)" stroke="#b6ab9a" stroke-width=".7"/>
          <g class="far-legs" stroke="#a99e8f" stroke-width="10" stroke-linecap="round"><path class="leg leg-back" d="m58 83-5 23h10"/><path class="leg leg-front" d="m106 81 9 25h8"/></g>
          <path d="M42 68q8-23 36-20l23 5 16-2 10 14-3 17-7 9q-34 13-68-4l-9-6 3-3-4-4 5-1Z" fill="url(#ragdoll-coat)" stroke="#c5bba8" stroke-width=".8"/>
          <path d="m44 68 6-3-4 8 6-2-1 7 6-1m17-24 8 2m-30 31 10 4 14 1" stroke="#fff6e4" stroke-width="1.5" stroke-linecap="round"/>
          <g class="near-legs"><g class="leg leg-front"><path d="m56 83 6 23q6 6 15 0" stroke="#e9dfca" stroke-width="10" stroke-linecap="round"/><path d="m70 106-1 3m5-3-1 3" stroke="#afa494" stroke-width=".7"/></g><g class="leg leg-back"><path d="m105 83-4 23q4 5 13 0" stroke="#f1e8d6" stroke-width="10" stroke-linecap="round"/><path d="m108 106-1 3m5-3-1 3" stroke="#afa494" stroke-width=".7"/></g></g>
          <path d="m101 51-6 4 5 1-4 6 6-1-3 8 6-2-1 7 7-3 2 5 6-8 5 3-1-9 7 1-5-8-3-11Z" fill="#f6edda" stroke="#c7beac" stroke-width=".7"/>
          <use href="#ragdoll-face" transform="translate(100 15) scale(.87)"/>
        </g>
        <g class="pose-sit">
          <path class="tail" d="M89 99c-25 16-61 12-61-2q-1-12 12-12l7 3-5 3 7 1-5 4q-8-3-7 2 7 6 43-5Z" fill="url(#ragdoll-tail)" stroke="#a99d8b" stroke-width=".8"/>
          <path d="M71 53q-15 9-18 32l-4 5 5 1-3 6q10 15 35 12 25 2 30-12l-2-5 2-6-5-1q-3-21-15-31Z" fill="url(#ragdoll-coat)" stroke="#b9ae9b" stroke-width=".8"/>
          <path d="m68 53-9 9 6-1-6 10 8-2-3 9 7-2-1 8 7-4 4 8 5-8 5 5 3-10 6 3-2-10 8 2-6-10 5 1-9-12Z" fill="#f8efdc" stroke="#d5cbb8" stroke-width=".65" stroke-linejoin="round"/>
          <path d="M73 80 70 104q5 6 13 2l1-25m9 0 3 23q6 5 13 0" fill="#ece2ce"/>
          <path d="m83 82-2 20m13-20 2 19M72 104l-1 3m5-3-1 4m23-4 1 3m4-4 1 4" stroke="#b1a691" stroke-width=".8" stroke-linecap="round"/>
          <path d="m57 85 6-5-3 7 4-1m44-5 3 7-4-2m-39-26 4 7m24-7-3 7m-16 2 3 8 3-8" stroke="#fff8e7" stroke-width="1.2" stroke-linecap="round"/>
          <use href="#ragdoll-face" transform="translate(55 13)"/>
        </g>
        <g class="pose-sleep">
          <path d="M31 94q-4-25 28-34 35-10 56 12 15 18 0 30-30 17-70 8Z" fill="url(#ragdoll-coat)" stroke="#b2a790" stroke-width=".9"/>
          <path d="m37 82 6-5-2 7 7-4-2 7m14-22 13-1m-27 38 9 3m40-35 6 4" stroke="#fff3de" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M32 94c-10 13 9 24 33 20q23-3 30-12l-8-1 2-4-9 1 1-3q-16 13-37 8-6-2-3-7Z" fill="url(#ragdoll-tail)" stroke="#a99e8b" stroke-width=".8"/>
          <path d="m101 72-4-14 12 8 10-1 10-9-1 18q9 17-8 23-20 4-24-11l-4-1 5-5-2-5Z" fill="url(#ragdoll-point)" stroke="#a99e8c" stroke-width=".8"/>
          <path d="m101 63 6 6-5 1m22-9-5 8 5-1" fill="#c4a99a"/>
          <path d="m112 69 3 9 5-9-3 15 8 6q-10 12-21 0l9-7Z" fill="#f2e8d4"/>
          <path d="m100 80q4 4 9 1m12-2q5 2 8-2" stroke="#4b4c4c" stroke-width="1.6" stroke-linecap="round"/>
          <path d="m111 88 4 2 2-4" fill="#b58a86"/><path d="m104 90-12 1m12 2-11 4m28-8 13-3m-12 6 12 1" stroke="#e0d8c8" stroke-width=".6" stroke-linecap="round"/>
          <path d="m77 105 5-2m-23 6 5 1m-18-9 4 3" stroke="#ccc0ac" stroke-width="1.1" stroke-linecap="round"/>
        </g>
      </g>
    </svg>
  </button>
</div>
<script>
const resident = document.querySelector<HTMLElement>('.ragdoll-resident');
if(resident) {
 const pet = resident.querySelector<HTMLButtonElement>('.ragdoll-pet')!;
 const motion = matchMedia('(prefers-reduced-motion: reduce)');
 const touch = matchMedia('(hover: none), (pointer: coarse)');
 let x = Math.max(12, innerWidth-120), target = x, speed = 0, frame = 0, previous = 0;
 let settleTimer: ReturnType<typeof setTimeout> | undefined;
 let happyTimer: ReturnType<typeof setTimeout> | undefined;
 let wakeTimer: ReturnType<typeof setTimeout> | undefined;
 let affection = false;
 function state(value: string) { if(!affection) resident!.dataset.state = value; }
 function paint() {resident!.style.transform = `translate3d(${x.toFixed(2)}px,0,0)`;}
 function rest() {
  cancelAnimationFrame(frame); frame=0; speed=0;clearTimeout(wakeTimer);wakeTimer=undefined; state('sitting');
  clearTimeout(settleTimer);
  if(!motion.matches) settleTimer=setTimeout(()=>state('sleeping'),8000);
 }
 function move(now: number) {
  frame=0;
  if(document.hidden || motion.matches || touch.matches || affection) return;
  const dt=Math.min((now-previous)/1000,.04); previous=now;
  const distance=target-x;
  const desired=Math.sign(distance)*Math.min(190,Math.abs(distance)*3.5);
  speed+=(desired-speed)*(1-Math.exp(-8*dt));
  x=Math.max(8,Math.min(innerWidth-88,x+speed*dt));
  if(Math.abs(speed)>9) {state('walking');resident!.dataset.facing=speed>0?'right':'left';}
  paint();
  if(Math.abs(target-x)<3 && Math.abs(speed)<9) {rest();return;}
  frame=requestAnimationFrame(move);
 }
 function follow(event: PointerEvent) {
  if(event.pointerType!=='mouse' || motion.matches || touch.matches || affection || pet.matches(':focus-visible')) return;
  if((event.target as Element).closest('.ragdoll-resident')) return;
  target=Math.max(8,Math.min(innerWidth-88,event.clientX-40));
  clearTimeout(settleTimer);
  if(Math.abs(target-x)<18) {if(!frame) rest();return;}
  if(!frame && !wakeTimer) {state('sitting');wakeTimer=setTimeout(()=>{wakeTimer=undefined;if(!frame){previous=performance.now();frame=requestAnimationFrame(move);}},110);}
 }
 document.addEventListener('pointermove',follow,{passive:true});
 pet.addEventListener('pointerenter',()=>{if(!affection) rest();});
 pet.addEventListener('click',()=>{
  cancelAnimationFrame(frame);frame=0;clearTimeout(settleTimer);clearTimeout(wakeTimer);clearTimeout(happyTimer);
  affection=true;resident.dataset.state='happy';
  happyTimer=setTimeout(()=>{affection=false;rest();},1400);
 });
 pet.addEventListener('keydown',event=>{if(event.key==='Escape'){clearTimeout(wakeTimer);rest();state('sleeping');pet.blur();}});
 function quiet(){clearTimeout(wakeTimer);rest();paint();}
 motion.addEventListener('change',quiet);touch.addEventListener('change',quiet);
 document.addEventListener('visibilitychange',()=>{if(document.hidden){clearTimeout(wakeTimer);cancelAnimationFrame(frame);frame=0;clearTimeout(settleTimer);}else rest();});
 window.addEventListener('resize',()=>{x=Math.max(8,Math.min(innerWidth-88,x));target=x;quiet();});
 paint();rest();
}
</script>
<style>
.ragdoll-resident{position:fixed;left:0;bottom:8px;width:80px;height:60px;z-index:30;pointer-events:none;contain:layout style;will-change:transform}
.ragdoll-pet{position:relative;display:block;width:80px;height:60px;padding:0;border:0;background:none;cursor:pointer;pointer-events:auto;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.ragdoll-pet:focus-visible{outline:1px solid #c5ed9c;outline-offset:4px;border-radius:12px}
.kitten{display:block;width:80px;height:60px;overflow:visible;filter:drop-shadow(0 2px 2px #0003)}
.kitten-facing{transform-origin:80px 60px}.ragdoll-resident[data-facing=left] .kitten-facing{transform:scaleX(-1)}
.pose-walk,.pose-sleep{display:none}.ragdoll-resident[data-state=walking] .pose-walk{display:initial}.ragdoll-resident[data-state=walking] .pose-sit{display:none}.ragdoll-resident[data-state=sleeping] .pose-sleep{display:initial}.ragdoll-resident[data-state=sleeping] .pose-sit{display:none}
.leg{transform-box:fill-box;transform-origin:center top}.ragdoll-resident[data-state=walking] .leg-front{animation:kitten-step .28s ease-in-out infinite alternate}.ragdoll-resident[data-state=walking] .leg-back{animation:kitten-step .28s ease-in-out infinite alternate-reverse}.ragdoll-resident[data-state=walking] .pose-walk{animation:kitten-bob .28s ease-in-out infinite alternate}
.tail{transform-origin:47px 74px;animation:kitten-tail 4s ease-in-out infinite}.kitten-eye{animation:kitten-blink 5.7s infinite;transform-box:fill-box;transform-origin:center}
.kitten-heart{position:absolute;top:-14px;left:35px;opacity:0;pointer-events:none;color:#c5ed9c;font:19px Satoshi,Arial,sans-serif}.ragdoll-resident[data-state=happy] .kitten-heart{animation:kitten-heart 1.35s ease-out both}.ragdoll-resident[data-state=happy] .pose-sit{animation:kitten-nuzzle .7s ease-in-out 2}
@keyframes kitten-step{from{transform:rotate(-18deg)}to{transform:rotate(18deg)}}
@keyframes kitten-bob{from{transform:translateY(0)}to{transform:translateY(-1.3px)}}
@keyframes kitten-tail{0%,70%,100%{transform:rotate(0)}82%{transform:rotate(-9deg)}92%{transform:rotate(4deg)}}
@keyframes kitten-blink{0%,44%,48%,100%{transform:scaleY(1)}46%{transform:scaleY(.12)}}
@keyframes kitten-heart{0%{opacity:0;transform:translateY(6px) scale(.7)}25%{opacity:1;transform:translateY(0) scale(1)}75%{opacity:1}100%{opacity:0;transform:translateY(-15px) scale(.8)}}
@keyframes kitten-nuzzle{50%{transform:translateY(-2px) rotate(-3deg)}}
@media(prefers-reduced-motion:reduce){.ragdoll-resident *{animation:none!important}.ragdoll-resident[data-state=happy] .kitten-heart{opacity:1}}
@media(hover:none),(pointer:coarse){.ragdoll-resident{bottom:9px}}
</style>


