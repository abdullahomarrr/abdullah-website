---
interface Props { active?: 'writing'; home?: boolean }
const {active,home=false}=Astro.props;
---
<header class="nav shell">
  <a class="brand" href={home?'#':'/'}><span>abdullah omar</span></a>
  <nav aria-label="Main navigation">
    <a href={home?'#projects':'/#projects'}>work</a>
    <a href={home?'#about':'/#about'}>about</a>
    <a href="/writing/" aria-current={active==='writing'?'page':undefined}>writing</a>
    <a href="/Abdullah-Omar-Resume-SWE.pdf" target="_blank" rel="noopener">resume ↗</a>
  </nav>
  <a class="nav-contact" href="mailto:abdullahom07@gmail.com">let’s talk ↗</a>
</header>
<style>
  .nav nav a[aria-current=page]{color:var(--fg);position:relative}
  .nav nav a[aria-current=page]::after{content:'';position:absolute;left:50%;bottom:2px;width:3px;height:3px;border-radius:50%;background:var(--lime)}
  @media(max-width:600px){.nav{gap:10px}.nav nav{gap:13px}.nav .brand{white-space:nowrap}.nav nav a{font-size:11px}}
  @media(max-width:360px){.nav nav{gap:9px}.nav .brand{font-size:10px}.nav nav a{font-size:10px}}
</style>
