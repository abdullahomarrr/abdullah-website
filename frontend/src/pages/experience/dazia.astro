---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
const contributions = [{"title": "a clearer view of the business", "body": "Built an internal analytics platform tracking 10+ metrics, giving leadership a centralized view of product usage, AI costs, and business performance."}, {"title": "more room to study", "body": "Expanded exams and flashcards to draw from multiple textbooks per course, removing the study workflow’s single-book restriction."}, {"title": "one consistent product", "body": "Rebuilt 8+ FinanceBuddy screens with reusable UI components and animation patterns to create a consistent experience across core workflows."}, {"title": "a better first experience", "body": "Developed interactive onboarding for 4 study tools, letting users practice key workflows without consuming LLM calls or user credits."}];
---
<ProjectLayout title="Dazia Consulting — Software Engineering Intern | Abdullah Omar" description="Contract software engineering internship at Dazia Consulting, May–July 2026. Analytics, study tools, and FinanceBuddy product interfaces.">
  <nav class="dazia-nav" aria-label="Page navigation"><a href="/#experience">← back to experience</a><a href="/">abdullah omar</a></nav>
  <main class="dazia-page">
    <div class="experience-spread">
      <header class="role-overview">
        <img class="dazia-logo" src="/brands/dazia.png" alt="Dazia Consulting" width="140" height="70"/>
        <p class="role-type">contract / may — july 2026</p>
        <h1>software <br/>engineering <br/><span>intern.</span></h1>
        <p class="role-summary">Analytics, study tools, and the interfaces that bring them together.</p>
        <dl class="role-details"><div><dt>company</dt><dd>Dazia Consulting</dd></div><div><dt>location</dt><dd>Toronto, Ontario</dd></div></dl>
        <div class="toolkit"><h2>built with</h2><p>React <span>·</span> JavaScript <span>·</span> Vite <span>·</span> Supabase</p></div>
      </header>
      <section class="contributions" aria-labelledby="contributions-title"><div class="contributions-heading"><h2 id="contributions-title">what i shipped</h2><span>four areas of work</span></div><ol>{contributions.map((item,i)=><li><span class="entry-number" aria-hidden="true">0{i+1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>)}</ol></section>
    </div>
    <footer class="dazia-footer"><span>Dazia Consulting · 2026</span><a href="/#experience">back to experience ↗</a></footer>
  </main>
</ProjectLayout>
<style>
.dazia-nav,.dazia-page{width:min(1100px,calc(100% - 80px));margin-inline:auto}.dazia-nav{height:60px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #d8dfcf18;font-size:12px;color:#a0ab94}.dazia-nav a:hover{color:#edf1e7}.experience-spread{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.35fr);gap:90px;padding:46px 0 36px}.dazia-logo{display:block;width:110px;height:55px;object-fit:contain;object-position:left;filter:brightness(0) invert(.93);margin-bottom:25px}.role-type{font-size:10px;color:#859379;line-height:1.5;margin:0 0 17px}h1{font:400 clamp(36px,3.8vw,48px)/1.07 Satoshi,Arial,sans-serif;letter-spacing:-.055em;margin:0}h1 span{color:#8b9881}.role-summary{font-size:14px;line-height:1.7;color:#aab69e;max-width:290px;margin:23px 0}.role-details{margin:0;display:grid;gap:10px;font-size:11px}.role-details div{display:grid;grid-template-columns:65px 1fr;gap:15px}.role-details dt{color:#6f8061}.role-details dd{margin:0;color:#c2ceB6}.toolkit{margin-top:27px}.toolkit h2{font-size:10px;font-weight:400;color:#6f8061;margin:0 0 8px}.toolkit p{font-size:11px;line-height:1.7;color:#a7b398;margin:0}.toolkit p span{margin-inline:5px;color:#56664b}.contributions{padding-top:9px}.contributions-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:6px}.contributions-heading h2{font-size:12px;font-weight:400;color:#c0cbb4;margin:0}.contributions-heading>span{font-size:10px;color:#64745a}.contributions ol{list-style:none;margin:0;padding:0}.contributions li{display:grid;grid-template-columns:20px 1fr;gap:18px;padding:26px 0;border-bottom:1px solid #d8dfcf18}.contributions li:last-child{border-bottom:0;padding-bottom:0}.entry-number{font-size:9px;line-height:1;color:#718162;padding-top:7px;font-variant-numeric:tabular-nums}.contributions h3{font-size:21px;line-height:1.2;font-weight:400;letter-spacing:-.035em;color:#e0e7d8;margin:0 0 12px}.contributions li p{font-size:13px;line-height:1.8;color:#a3b096;margin:0}.dazia-footer{display:flex;justify-content:space-between;gap:20px;padding:18px 0 25px;border-top:1px solid #d8dfcf18;font-size:10px;color:#718162}.dazia-footer a{color:#bccdb0}
@media(min-width:901px) and (min-height:850px){.experience-spread{padding-top:clamp(46px,8vh,100px);padding-bottom:55px}.contributions li{padding-block:30px}}
@media(max-width:950px){.experience-spread{gap:45px;grid-template-columns:.85fr 1.3fr}.dazia-nav,.dazia-page{width:calc(100% - 44px)}.contributions h3{font-size:19px}.contributions li{gap:12px}.contributions li p{font-size:12px}}
@media(max-width:700px){.experience-spread{grid-template-columns:1fr;gap:32px;padding:30px 0}.dazia-nav{font-size:11px}.dazia-logo{width:90px;height:45px;margin-bottom:20px}h1{font-size:39px}h1 br{display:none}h1 br::after{content:' '}.role-summary{max-width:340px;font-size:14px;margin:18px 0}.role-overview h1{max-width:340px}.role-details{font-size:12px}.toolkit{margin-top:20px}.contributions{padding-top:24px;border-top:1px solid #d8dfcf18}.contributions li{padding:23px 0}.contributions h3{font-size:21px}.contributions li p{font-size:13px}.toolkit p{font-size:12px}}
</style>
