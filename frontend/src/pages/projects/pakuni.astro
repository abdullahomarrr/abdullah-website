---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const steps = [
  ['Profile', 'Identity & domicile'],
  ['Academics', 'Matric & Inter'],
  ['Documents', 'Upload once'],
  ['Programs', 'Choose where to apply'],
  ['Review', 'Check & submit'],
];
const details = [
  { title: 'One profile, reused.', text: 'A canonical applicant profile connects to multiple program submissions. Personal details and academic records stay in one place, instead of being entered again for every application.' },
  { title: 'Built around local requirements.', text: 'Server-side checks cover CNIC and passport formats, domicile, Matric and Inter records, and required document formats. The workflow reflects how students apply in Pakistan.' },
  { title: 'A clear path to submission.', text: 'Each stage checks for completion before the next. Missing-item indicators surface incomplete information before review, so applicants know what still needs attention.' },
];
---

<ProjectLayout title="PakUni — Abdullah Omar" description="A closer look at PakUni: a full-stack admissions MVP that brings Pakistani university applications into one reusable workflow.">
  <nav class="pu-nav" aria-label="Project navigation">
    <a href="/#projects"><span aria-hidden="true">←</span> back to projects</a>
    <a href="/" class="pu-name">abdullah omar</a>
  </nav>

  <main class="pu-study">
    <header class="pu-intro">
      <div class="pu-eyebrow"><span>Selected project / 2026</span><span class="pu-status">Full-stack MVP</span></div>
      <h1>PakUni<span aria-hidden="true">.</span></h1>
      <div class="pu-intro-bottom">
        <h2>More possibilities.<br /><span>Less repetition.</span></h2>
        <p>A single starting point for Pakistani university admissions. Build one applicant profile, keep documents together, and apply to multiple programs through a guided flow.</p>
      </div>
      <dl class="pu-meta">
        <div><dt>Focus</dt><dd>University admissions</dd></div>
        <div><dt>Built with</dt><dd>Python · JavaScript · FastAPI · MongoDB</dd></div>
        <div><dt>Scope</dt><dd>End-to-end application workflow</dd></div>
      </dl>
    </header>

    <section class="pu-section" aria-labelledby="pu-context">
      <div class="pu-margin"><span>01 / The starting point</span></div>
      <div class="pu-body">
        <h2 id="pu-context">Applying again shouldn’t<br class="pu-desktop" /> mean starting again.</h2>
        <p>For students applying to multiple Pakistani universities, each portal means another form, another upload, and another set of requirements to keep track of.</p>
        <p>PakUni brings that process together in an OUAC-style admissions flow: one reusable profile, a shared document locker, and a structured way to choose programs and submit.</p>
      </div>
    </section>

    <section class="pu-journey" aria-labelledby="pu-flow">
      <div class="pu-journey-heading"><div><span class="pu-kicker">02 / The application journey</span><h2 id="pu-flow">One profile. Five clear steps.</h2></div><p>From your first detail<br />to your final review.</p></div>
      <ol class="pu-steps">
        {steps.map(([name, description], index) => <li><span class="pu-step-number">0{index + 1}</span><h3>{name}</h3><p>{description}</p></li>)}
      </ol>
      <p class="pu-flow-note"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m4 10 4 4 8-8" stroke="currentColor" stroke-width="1.5" /></svg>Completion checks at each stage. Reusable details across applications.</p>
    </section>

    <section class="pu-section pu-engineering" aria-labelledby="pu-build">
      <div class="pu-margin"><span>03 / Under the surface</span><h2 id="pu-build">Making the<br />pieces work.</h2></div>
      <div class="pu-body pu-notes">
        {details.map((detail, index) => <article><span class="pu-note-index">0{index + 1}</span><div><h3>{detail.title}</h3><p>{detail.text}</p></div></article>)}
      </div>
    </section>

    <section class="pu-outcome" aria-labelledby="pu-result">
      <span class="pu-kicker">04 / What came out of it</span>
      <h2 id="pu-result">A connected application flow,<br /><span>from profile to submission.</span></h2>
      <p>A full-stack MVP bringing reusable applicant data, document uploads, program selection, and submission checks into one place.</p>
      <a href="/#projects">explore more projects <span aria-hidden="true">↗</span></a>
    </section>
  </main>
  <footer class="pu-footer"><a href="/">Abdullah Omar</a><span>PakUni / 2026</span></footer>
</ProjectLayout>

<style>
  .pu-nav,.pu-study,.pu-footer{width:min(1080px,calc(100% - 96px));margin-inline:auto}
  .pu-nav{height:88px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);font-size:14px}
  a{color:var(--muted);text-decoration:none;transition:color .25s ease}a:hover{color:var(--text)}
  .pu-nav a:first-child{display:flex;gap:12px;align-items:center}.pu-name{color:var(--text)}
  .pu-intro{padding:68px 0 0}.pu-eyebrow{display:flex;justify-content:space-between;gap:20px;align-items:center;color:var(--muted);font-size:12px}
  .pu-status{display:flex;align-items:center;gap:8px}.pu-status:before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent)}
  h1{font-size:clamp(80px,12vw,144px);font-weight:400;line-height:1.1;letter-spacing:-.075em;margin:25px 0 36px}h1 span{color:var(--accent)}
  h2,h3,p{margin:0}h2,h3{font-weight:400;letter-spacing:-.04em}
  .pu-intro-bottom{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:end}.pu-intro-bottom h2{font-size:clamp(28px,3.2vw,40px);line-height:1.16}.pu-intro-bottom h2 span{color:var(--muted)}
  p{color:var(--muted);font-size:16px;line-height:1.8}.pu-intro-bottom p{max-width:460px}
  .pu-meta{display:grid;grid-template-columns:1fr 1.5fr 1.2fr;gap:24px;margin:46px 0 0;padding:24px 0;border-block:1px solid var(--border)}dt{font-size:11px;color:var(--muted);margin-bottom:9px}dd{margin:0;font-size:13px;color:#d0d6c9}
  .pu-section{display:grid;grid-template-columns:1fr 2fr;gap:60px;padding:76px 0}.pu-margin>span,.pu-kicker{font-size:12px;color:var(--muted)}
  .pu-body h2{font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin-bottom:24px}.pu-body>p+p{margin-top:16px}.pu-body{max-width:650px}
  .pu-journey{background:#151a13;border:1px solid #b8caa51c;border-radius:16px;padding:32px}.pu-journey-heading{display:flex;justify-content:space-between;gap:30px;align-items:end}.pu-journey-heading h2{font-size:28px;margin-top:14px}.pu-journey-heading>p{font-size:13px;line-height:1.6}
  .pu-steps{display:grid;grid-template-columns:repeat(5,1fr);padding:0;margin:34px 0 26px;list-style:none}.pu-steps li{position:relative;border-top:1px solid #b8caa533;padding:20px 10px 0 0}.pu-steps li:before{content:'';position:absolute;left:0;top:-3px;width:5px;height:5px;border-radius:50%;background:#a9c48d}.pu-step-number{font-size:11px;color:#7e8e73}.pu-steps h3{font-size:18px;margin-top:15px}.pu-steps p{font-size:12px;margin-top:5px}
  .pu-flow-note{display:flex;gap:9px;align-items:center;font-size:12px;padding-top:20px;border-top:1px solid #b8caa51a}.pu-flow-note svg{width:18px;flex-shrink:0;color:var(--accent)}
  .pu-engineering{padding-bottom:64px}.pu-margin h2{font-size:30px;margin-top:22px;line-height:1.2}.pu-notes article{display:flex;gap:24px;padding:25px 0;border-bottom:1px solid var(--border)}.pu-notes article:first-child{padding-top:0}.pu-note-index{font-size:11px;color:#77866b;padding-top:6px}.pu-notes h3{font-size:23px;margin-bottom:12px}.pu-notes p{font-size:15px}
  .pu-outcome{padding:48px 0 60px;border-top:1px solid var(--border)}.pu-outcome h2{font-size:clamp(28px,3.8vw,44px);line-height:1.2;margin:22px 0}.pu-outcome h2 span{color:var(--muted)}.pu-outcome p{max-width:610px}.pu-outcome a{display:inline-flex;gap:30px;margin-top:30px;font-size:14px;color:var(--text);border-bottom:1px solid #a2ab9955;padding-bottom:9px}.pu-outcome a span{color:var(--accent)}
  .pu-footer{display:flex;justify-content:space-between;border-top:1px solid var(--border);padding:25px 0 35px;font-size:12px;color:var(--muted)}
  @media(max-width:760px){.pu-nav,.pu-study,.pu-footer{width:calc(100% - 40px)}.pu-nav{height:70px;font-size:12px}.pu-intro{padding-top:40px}.pu-eyebrow{font-size:11px}h1{margin:25px 0 28px}.pu-intro-bottom{grid-template-columns:1fr;gap:22px}.pu-intro-bottom p{max-width:none;font-size:15px}.pu-meta{grid-template-columns:1fr;gap:18px;margin-top:30px;padding:22px 0}.pu-meta div{display:grid;grid-template-columns:72px 1fr;gap:12px}dt{margin:0;padding-top:2px}dd{font-size:12px}.pu-section{grid-template-columns:1fr;gap:24px;padding:42px 0}.pu-body p{font-size:15px}.pu-desktop{display:none}.pu-journey{padding:24px 20px}.pu-journey-heading>p{display:none}.pu-journey-heading h2{font-size:25px}.pu-steps{grid-template-columns:1fr;margin:28px 0 18px}.pu-steps li{border-top:0;border-left:1px solid #b8caa533;padding:0 0 22px 22px;display:grid;grid-template-columns:25px 1fr;gap:0 12px}.pu-steps li:before{top:7px;left:-3px}.pu-steps li:last-child{padding-bottom:0;border-left-color:transparent}.pu-step-number{padding-top:4px}.pu-steps h3{margin:0;font-size:17px}.pu-steps p{grid-column:2;margin:2px 0 0}.pu-flow-note{align-items:flex-start;font-size:11px}.pu-flow-note svg{margin-top:2px}.pu-margin h2{margin-top:15px;font-size:28px}.pu-margin h2 br{display:none}.pu-notes article{gap:16px}.pu-notes h3{font-size:21px}.pu-outcome{padding:35px 0 42px}.pu-outcome p{font-size:15px}}
</style>
