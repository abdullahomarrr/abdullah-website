---
import {getCollection} from 'astro:content';
import WritingLayout from '../../layouts/WritingLayout.astro';
export async function getStaticPaths(){
  return (await getCollection('writing',({data})=>!data.draft)).map(entry=>({params:{slug:entry.slug},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await entry.render();
const minutes=Math.max(1,Math.ceil(entry.body.split(/\s+/).length/220));
---
<WritingLayout title={entry.data.title} description={entry.data.description}>
  <article class="essay">
    <a class="back" href="/writing/">← all writing</a>
    <header><div class="essay-meta"><span>{entry.data.topic}</span><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('en-CA',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><span>{minutes} min read</span></div><h1>{entry.data.title}</h1><p>{entry.data.description}</p></header>
    <div class="essay-body"><Content/></div>
    <div class="essay-end"><a href="/writing/">← back to the notebook</a><a href={`mailto:abdullahom07@gmail.com?subject=${encodeURIComponent(entry.data.title)}`}>share a thought ↗</a></div>
  </article>
</WritingLayout>
<style>
  .essay{max-width:680px;margin:auto}.back{font-size:12px;color:#a2af95}.back:hover{color:var(--fg)}
  .essay header{margin:45px 0 40px;padding-bottom:30px;border-bottom:1px solid var(--line)}.essay-meta{display:flex;flex-wrap:wrap;gap:10px 20px;color:#92a084;font-size:11px}
  .essay h1{font-size:clamp(35px,4vw,58px);font-weight:400;letter-spacing:-.05em;line-height:1.12;margin:20px 0}.essay header p{font-size:17px;line-height:1.7;color:#a7b29c}
  .essay-body{font-size:16px;line-height:1.9;color:#c7cfbf;overflow-wrap:anywhere}
  .essay-body :global(p){margin:0 0 24px}.essay-body :global(h2){font-size:28px;line-height:1.3;font-weight:500;letter-spacing:-.035em;margin:42px 0 18px;color:var(--fg)}.essay-body :global(h3){font-size:21px;margin:30px 0 15px;color:var(--fg)}
  .essay-body :global(a){color:var(--lime);text-decoration:underline;text-underline-offset:4px}.essay-body :global(blockquote){border-left:2px solid #81996b;margin:30px 0;padding-left:22px;color:#b4c2a6}.essay-body :global(img){border-radius:8px;margin:30px 0;height:auto}
  .essay-body :global(pre){max-width:100%;overflow-x:auto;padding:20px;border:1px solid var(--line);border-radius:8px;font-size:13px}.essay-body :global(ul),.essay-body :global(ol){padding-left:24px;margin-bottom:24px}.essay-body :global(li){padding-left:5px;margin-bottom:8px}
  .essay-end{display:flex;justify-content:space-between;gap:18px;margin-top:60px;padding-top:23px;border-top:1px solid var(--line);font-size:12px;color:#a2af95}
  @media(max-width:600px){.essay header{margin-top:32px}.essay-body{font-size:15px}.essay-end{font-size:11px}}
</style>
