---
import {getCollection} from 'astro:content';
import WritingLayout from '../../layouts/WritingLayout.astro';
const entries=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const date=(value:Date)=>value.toLocaleDateString('en-CA',{year:'numeric',month:'short',day:'numeric',timeZone:'UTC'});
---
<WritingLayout>
  <section class="writing-grid" aria-labelledby="writing-title">
    <header class="writing-intro">
      <h1 id="writing-title">a few<br/><span>thoughts.</span></h1>
      <p>On building, learning,<br/>and everything in between.</p>
    </header>
    <div class="writing-entries">
      <div class="list-heading"><span>entries</span><span>{entries.length?'newest first':'just getting started'}</span></div>
      {entries.length ? entries.map((entry,index)=>(
        <a class="writing-entry" href={`/writing/${entry.slug}/`}>
          <span class="entry-number">{String(index+1).padStart(2,'0')}</span>
          <div><div class="entry-meta"><span>{entry.data.topic}</span><time datetime={entry.data.date.toISOString()}>{date(entry.data.date)}</time></div><h2>{entry.data.title}</h2><p>{entry.data.description}</p></div>
          <svg class="entry-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg>
        </a>
      )) : (
        <div class="first-page">
          <span class="page-number" aria-hidden="true">01</span>
          <div><span class="draft-label"><i aria-hidden="true"></i> room for the first thought</span><h2>nothing published.<br/><span>yet.</span></h2><p>A few things worth putting into words.<br/>The first entry will live here.</p></div>
          <div class="page-rule" aria-hidden="true"></div>
        </div>
      )}
    </div>
  </section>
</WritingLayout>
<style>
  .writing-grid{display:grid;grid-template-columns:1fr 1.55fr;gap:clamp(40px,7vw,100px);padding-top:0}
  .writing-intro h1{font-size:clamp(48px,5.4vw,76px);font-weight:400;line-height:1.04;letter-spacing:-.06em}
  .writing-intro h1 span{color:#8e9b80}.writing-intro>p{font-size:14px;color:#a2ab99;line-height:1.8;margin-top:25px}
  .list-heading{display:flex;justify-content:space-between;gap:15px;font-size:10px;color:#929f87;padding:4px 0 22px;border-bottom:1px solid var(--line)}
  .first-page{position:relative;display:grid;grid-template-columns:32px 1fr;gap:16px;padding:39px 0 45px;border-bottom:1px solid var(--line)}
  .page-number{font-size:11px;color:#637258;font-variant-numeric:tabular-nums;padding-top:3px}
  .draft-label{display:flex;align-items:center;gap:8px;font-size:10px;color:#9daa90}.draft-label i{width:4px;height:4px;border:1px solid #9daa90;border-radius:50%}
  .first-page h2{font-size:clamp(30px,3.2vw,43px);font-weight:400;letter-spacing:-.045em;line-height:1.2;margin-top:25px}.first-page h2 span{color:#87977b}
  .first-page p{font-size:13px;line-height:1.9;color:#929e88;margin-top:22px}
  .page-rule{grid-column:2;width:38px;height:1px;background:#687b58;margin-top:20px}
  .writing-entry{display:grid;grid-template-columns:25px 1fr 18px;gap:18px;padding:28px 0;border-bottom:1px solid var(--line);transition:border-color .35s}
  .writing-entry .entry-number{margin:0;color:#748267;font-size:10px}.entry-meta{display:flex;gap:16px;justify-content:space-between;font-size:10px;color:#8e9c82}
  .writing-entry h2{font-size:25px;line-height:1.25;font-weight:400;letter-spacing:-.035em;margin:13px 0 10px;transition:color .35s}.writing-entry p{color:var(--muted);font-size:13px;line-height:1.7}
  .entry-arrow{width:17px;margin-top:25px;color:#849a70;transition:transform .4s,color .4s}.writing-entry:hover{border-color:#667958}.writing-entry:hover h2{color:var(--lime)}.writing-entry:hover .entry-arrow{transform:translate(2px,-2px);color:var(--lime)}
  @media(max-width:700px){.writing-grid{grid-template-columns:1fr;gap:42px;padding-top:0}.writing-intro h1 br{display:none}.writing-intro h1 span{margin-left:.18em}.writing-intro h1{font-size:49px}.writing-intro>p{margin-top:18px}.first-page{padding:30px 0 35px;gap:10px;grid-template-columns:22px 1fr}.first-page h2{font-size:33px}.writing-entry{gap:10px;grid-template-columns:20px 1fr 16px}.writing-entry h2{font-size:23px}.entry-meta{flex-wrap:wrap;gap:6px 14px}}
  @media(prefers-reduced-motion:reduce){.writing-entry,.writing-entry h2,.entry-arrow{transition:none}}
</style>
